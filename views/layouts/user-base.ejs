<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title><%= pageTitle || "User Dashboard" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Bootstrap CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-Gnf8AknG5UqH+xQ3uBgBwG3Y+vjcC69oFe3b1pIekVYjEX0ohYh9KYRI4NzOeFbb"
    crossorigin="anonymous"
  />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/user/css/style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />
</head>
<body class="dark-mode">

  <div class="container-fluid d-flex flex-column flex-md-row p-0">

    <!-- Sidebar -->
    <aside class="bg-dark text-white p-3 vh-100" id="sidebar">
      <div class="d-flex align-items-center mb-3">
        <img src="/user/images/logo.png" alt="Logo" class="me-2" style="height: 40px;" />
        <h4 class="mb-0">MyCRM</h4>
      </div>
      <nav class="nav flex-column">
        <a href="/user/dashboard" class="nav-link text-white <%= page === 'dashboard' ? 'active fw-bold' : '' %>">
          <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>
        <a href="/user/attendance" class="nav-link text-white <%= page === 'attendance' ? 'active fw-bold' : '' %>">
          <i class="bi bi-calendar-check me-2"></i>Attendance
        </a>
        <a href="/user/leaves" class="nav-link text-white <%= page === 'leaves' ? 'active fw-bold' : '' %>">
          <i class="bi bi-calendar-x me-2"></i>Leaves
        </a>
        <a href="/user/feedback" class="nav-link text-white <%= page === 'feedback' ? 'active fw-bold' : '' %>">
          <i class="bi bi-chat-dots me-2"></i>Feedback
        </a>
        <a href="/user/profile" class="nav-link text-white <%= page === 'profile' ? 'active fw-bold' : '' %>">
          <i class="bi bi-person-circle me-2"></i>Profile
        </a>
        <a href="/auth/logout" class="nav-link text-white">
          <i class="bi bi-box-arrow-right me-2"></i>Logout
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-grow-1 p-4 bg-light" id="mainContent">
      <%- body %>
    </main>
  </div>

  <!-- Toggle Sidebar (for mobile later if needed) -->
  <script>
    // You can enhance this if you later add a mobile toggle
  </script>

  <!-- Bootstrap JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-kFBUr8uQmrCTJj0Jm9lf19cvpxLZG0ZKOTzYytkvZ0W/Nz3C0W6ZmG1B1M9XU1da"
    crossorigin="anonymous"
  ></script>
</body>
</html>

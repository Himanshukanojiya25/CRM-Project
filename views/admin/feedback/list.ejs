<%- include('../layouts/admin-base') %>

<div class="p-6">
    <!-- Header Section -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">Feedback Management</h1>
        <p class="text-gray-400">Manage and analyze all customer feedback in one place</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gradient-to-br from-cyan-500/10 to-blue-500/10 backdrop-blur-xl rounded-2xl p-6 border border-cyan-500/20 hover:border-cyan-500/40 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-cyan-400 text-sm font-medium">Total Feedback</p>
                    <p class="text-2xl font-bold text-white mt-2">
                        <%= pagination.total || feedbacks.length %>
                    </p>
                    <p class="text-green-400 text-xs mt-1">↑ 12% this month</p>
                </div>
                <div class="w-12 h-12 bg-cyan-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-comments text-cyan-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-green-500/10 to-emerald-500/10 backdrop-blur-xl rounded-2xl p-6 border border-green-500/20 hover:border-green-500/40 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-green-400 text-sm font-medium">Responded</p>
                    <p class="text-2xl font-bold text-white mt-2">
                        <%= feedbacks.filter(f => f.responses && f.responses.length > 0).length %>
                    </p>
                    <p class="text-green-400 text-xs mt-1">
                        <% 
                            const respondedPercent = feedbacks.length > 0 
                                ? Math.round((feedbacks.filter(f => f.responses && f.responses.length > 0).length / feedbacks.length) * 100)
                                : 0;
                        %>
                        <%= respondedPercent %>% completion
                    </p>
                </div>
                <div class="w-12 h-12 bg-green-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-check-circle text-green-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-orange-500/10 to-red-500/10 backdrop-blur-xl rounded-2xl p-6 border border-orange-500/20 hover:border-orange-500/40 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-orange-400 text-sm font-medium">Pending</p>
                    <p class="text-2xl font-bold text-white mt-2">
                        <%= feedbacks.filter(f => f.status === 'pending').length %>
                    </p>
                    <p class="text-orange-400 text-xs mt-1">Requires attention</p>
                </div>
                <div class="w-12 h-12 bg-orange-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-clock text-orange-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 backdrop-blur-xl rounded-2xl p-6 border border-purple-500/20 hover:border-purple-500/40 transition-all duration-300">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-purple-400 text-sm font-medium">Avg Rating</p>
                    <p class="text-2xl font-bold text-white mt-2">
                        <% 
                            const avgRating = feedbacks.length > 0 
                                ? (feedbacks.reduce((sum, f) => sum + f.rating, 0) / feedbacks.length).toFixed(1)
                                : '0.0';
                        %>
                        <%= avgRating %>/5
                    </p>
                    <div class="flex text-yellow-400 text-xs mt-1">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <i class="fas <%= i <= avgRating ? 'fa-star' : 'fa-star' %>"></i>
                        <% } %>
                    </div>
                </div>
                <div class="w-12 h-12 bg-purple-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-star text-purple-400 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters and Actions -->
    <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50 mb-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-4 md:space-y-0">
            <div class="flex flex-wrap gap-4">
                <div class="relative">
                    <select class="bg-gray-700/50 border border-gray-600/50 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:border-transparent appearance-none pr-10">
                        <option>All Status</option>
                        <option>Pending</option>
                        <option>Responded</option>
                        <option>Resolved</option>
                    </select>
                    <i class="fas fa-chevron-down absolute right-3 top-3 text-gray-400"></i>
                </div>
                
                <div class="relative">
                    <select class="bg-gray-700/50 border border-gray-600/50 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:border-transparent appearance-none pr-10">
                        <option>All Categories</option>
                        <option>Bug Report</option>
                        <option>Feature Request</option>
                        <option>General Feedback</option>
                    </select>
                    <i class="fas fa-chevron-down absolute right-3 top-3 text-gray-400"></i>
                </div>

                <div class="relative">
                    <input type="text" placeholder="Search feedback..." class="bg-gray-700/50 border border-gray-600/50 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:border-transparent pl-10 w-64">
                    <i class="fas fa-search absolute left-3 top-3 text-gray-400"></i>
                </div>
            </div>

            <div class="flex space-x-3">
                <button class="bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-600 hover:to-blue-600 text-white px-6 py-2.5 rounded-xl font-medium transition-all duration-300 transform hover:scale-105">
                    <i class="fas fa-plus mr-2"></i>New Feedback
                </button>
                <button class="bg-gray-700/50 hover:bg-gray-600/50 border border-gray-600/50 text-white px-4 py-2.5 rounded-xl font-medium transition-all duration-300">
                    <i class="fas fa-download mr-2"></i>Export
                </button>
            </div>
        </div>
    </div>

    <!-- Feedback List -->
    <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl border border-gray-700/50 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-gray-700/50">
                        <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Feedback</th>
                        <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Category</th>
                        <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Rating</th>
                        <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-700/30">
                    <% if (feedbacks && feedbacks.length > 0) { %>
                        <% feedbacks.forEach(feedback => { %>
                            <tr class="hover:bg-gray-700/20 transition-all duration-300">
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="w-10 h-10 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full flex items-center justify-center text-white font-bold text-sm mr-4">
                                            <%= feedback.user.name.split(' ').map(n => n[0]).join('').toUpperCase() %>
                                        </div>
                                        <div>
                                            <p class="text-white font-medium"><%= feedback.title %></p>
                                            <p class="text-gray-400 text-sm mt-1">
                                                <%= feedback.description.length > 60 ? feedback.description.substring(0, 60) + '...' : feedback.description %>
                                            </p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium 
                                        <%= feedback.category === 'bug' ? 'bg-red-500/20 text-red-400 border border-red-500/30' : '' %>
                                        <%= feedback.category === 'positive' ? 'bg-green-500/20 text-green-400 border border-green-500/30' : '' %>
                                        <%= feedback.category === 'feature' ? 'bg-blue-500/20 text-blue-400 border border-blue-500/30' : '' %>
                                        <%= feedback.category === 'general' ? 'bg-gray-500/20 text-gray-400 border border-gray-500/30' : '' %>">
                                        <i class="fas 
                                            <%= feedback.category === 'bug' ? 'fa-bug' : '' %>
                                            <%= feedback.category === 'positive' ? 'fa-thumbs-up' : '' %>
                                            <%= feedback.category === 'feature' ? 'fa-lightbulb' : '' %>
                                            <%= feedback.category === 'general' ? 'fa-comment' : '' %>
                                            mr-1"></i>
                                        <%= feedback.category.charAt(0).toUpperCase() + feedback.category.slice(1).replace('_', ' ') %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium 
                                        <%= feedback.status === 'pending' ? 'bg-orange-500/20 text-orange-400 border border-orange-500/30' : '' %>
                                        <%= feedback.status === 'resolved' ? 'bg-green-500/20 text-green-400 border border-green-500/30' : '' %>
                                        <%= feedback.status === 'in-progress' ? 'bg-blue-500/20 text-blue-400 border border-blue-500/30' : '' %>
                                        <%= feedback.status === 'new' ? 'bg-purple-500/20 text-purple-400 border border-purple-500/30' : '' %>">
                                        <i class="fas 
                                            <%= feedback.status === 'pending' ? 'fa-clock' : '' %>
                                            <%= feedback.status === 'resolved' ? 'fa-check' : '' %>
                                            <%= feedback.status === 'in-progress' ? 'fa-spinner' : '' %>
                                            <%= feedback.status === 'new' ? 'fa-star' : '' %>
                                            mr-1"></i>
                                        <%= feedback.status.charAt(0).toUpperCase() + feedback.status.slice(1).replace('_', ' ') %>
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex text-yellow-400 text-sm">
                                        <% for(let i = 1; i <= 5; i++) { %>
                                            <i class="fas <%= i <= feedback.rating ? 'fa-star' : 'fa-star' %>"></i>
                                        <% } %>
                                        <span class="text-gray-400 text-xs ml-2 mt-1">(<%= feedback.rating %>)</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-gray-300">
                                    <%= new Date(feedback.createdAt).toLocaleDateString('en-IN', { 
                                        day: '2-digit', 
                                        month: 'short', 
                                        year: 'numeric' 
                                    }) %>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex space-x-2">
                                        <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                                            <i class="fas fa-eye text-xs"></i>
                                        </button>
                                        <button class="w-8 h-8 bg-green-500/20 hover:bg-green-500/30 border border-green-500/30 rounded-lg flex items-center justify-center text-green-400 transition-all duration-300">
                                            <i class="fas fa-reply text-xs"></i>
                                        </button>
                                        <button class="w-8 h-8 bg-red-500/20 hover:bg-red-500/30 border border-red-500/30 rounded-lg flex items-center justify-center text-red-400 transition-all duration-300">
                                            <i class="fas fa-trash text-xs"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="px-6 py-8 text-center text-gray-400">
                                <i class="fas fa-inbox text-4xl mb-2"></i>
                                <p>No feedback found</p>
                                <p class="text-sm mt-2">All feedback will appear here</p>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-gray-700/50">
            <div class="flex items-center justify-between">
                <div class="text-gray-400 text-sm">
                    Showing <%= feedbacks.length %> of <%= pagination.total %> results
                </div>
                <div class="flex space-x-2">
                    <button class="w-10 h-10 bg-gray-700/50 hover:bg-gray-600/50 border border-gray-600/50 rounded-lg flex items-center justify-center text-gray-300 transition-all duration-300">
                        <i class="fas fa-chevron-left"></i>
                    </button>
                    <button class="w-10 h-10 bg-gradient-to-r from-cyan-500 to-blue-500 text-white rounded-lg flex items-center justify-center">1</button>
                    <button class="w-10 h-10 bg-gray-700/50 hover:bg-gray-600/50 border border-gray-600/50 rounded-lg flex items-center justify-center text-gray-300 transition-all duration-300">2</button>
                    <button class="w-10 h-10 bg-gray-700/50 hover:bg-gray-600/50 border border-gray-600/50 rounded-lg flex items-center justify-center text-gray-300 transition-all duration-300">3</button>
                    <button class="w-10 h-10 bg-gray-700/50 hover:bg-gray-600/50 border border-gray-600/50 rounded-lg flex items-center justify-center text-gray-300 transition-all duration-300">
                        <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin/feedback/main.js"></script>
<script src="/js/admin/feedback/filters.js"></script>

<script>
console.log('✅ Feedback page loaded successfully');
console.log('Total feedbacks:', <%= feedbacks.length %>);
console.log('Pagination:', <%= JSON.stringify(pagination) %>);

// Real-time data updates
setInterval(async () => {
    try {
        const response = await fetch('/admin/feedback/api');
        const result = await response.json();
        
        if (result.success) {
            console.log('🔄 Feedback data updated:', result.data.length);
            // You can add real-time update logic here
        }
    } catch (error) {
        console.log('⚠️ Auto-refresh failed:', error.message);
    }
}, 30000); // Refresh every 30 seconds
</script>
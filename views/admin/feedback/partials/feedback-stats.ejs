<!-- Real-time Feedback Statistics -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <!-- Total Feedback Card -->
    <div class="bg-gradient-to-br from-cyan-500/10 to-blue-500/10 backdrop-blur-xl rounded-2xl p-6 border border-cyan-500/20 hover:border-cyan-500/40 transition-all duration-300 group cursor-pointer">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-cyan-400 text-sm font-medium">Total Feedback</p>
                <p id="total-feedback" class="text-2xl font-bold text-white mt-2">1,247</p>
                <p class="text-green-400 text-xs mt-1 flex items-center">
                    <i class="fas fa-arrow-up mr-1"></i>12% this month
                </p>
            </div>
            <div class="w-12 h-12 bg-cyan-500/20 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-comments text-cyan-400 text-xl"></i>
            </div>
        </div>
    </div>

    <!-- Responded Card -->
    <div class="bg-gradient-to-br from-green-500/10 to-emerald-500/10 backdrop-blur-xl rounded-2xl p-6 border border-green-500/20 hover:border-green-500/40 transition-all duration-300 group cursor-pointer">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-green-400 text-sm font-medium">Responded</p>
                <p id="responded-feedback" class="text-2xl font-bold text-white mt-2">894</p>
                <p class="text-green-400 text-xs mt-1">71% completion rate</p>
            </div>
            <div class="w-12 h-12 bg-green-500/20 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-check-circle text-green-400 text-xl"></i>
            </div>
        </div>
    </div>

    <!-- Pending Card -->
    <div class="bg-gradient-to-br from-orange-500/10 to-red-500/10 backdrop-blur-xl rounded-2xl p-6 border border-orange-500/20 hover:border-orange-500/40 transition-all duration-300 group cursor-pointer">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-orange-400 text-sm font-medium">Pending</p>
                <p id="pending-feedback" class="text-2xl font-bold text-white mt-2">218</p>
                <p class="text-orange-400 text-xs mt-1">Requires attention</p>
            </div>
            <div class="w-12 h-12 bg-orange-500/20 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-clock text-orange-400 text-xl"></i>
            </div>
        </div>
    </div>

    <!-- Average Rating Card -->
    <div class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 backdrop-blur-xl rounded-2xl p-6 border border-purple-500/20 hover:border-purple-500/40 transition-all duration-300 group cursor-pointer">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-purple-400 text-sm font-medium">Avg Rating</p>
                <p class="text-2xl font-bold text-white mt-2">4.2/5</p>
                <div class="flex text-yellow-400 text-xs mt-1">
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star"></i>
                    <i class="fas fa-star-half-alt"></i>
                </div>
            </div>
            <div class="w-12 h-12 bg-purple-500/20 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                <i class="fas fa-star text-purple-400 text-xl"></i>
            </div>
        </div>
    </div>
</div>

<!-- Mini Analytics Row -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Satisfaction Score -->
    <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-4 border border-gray-700/50">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-400 text-sm">Satisfaction Score</p>
                <p class="text-white font-semibold text-lg">8.7/10</p>
            </div>
            <div class="w-10 h-10 bg-cyan-500/20 rounded-full flex items-center justify-center">
                <i class="fas fa-smile text-cyan-400"></i>
            </div>
        </div>
        <div class="w-full bg-gray-700 rounded-full h-2 mt-2">
            <div class="bg-cyan-500 h-2 rounded-full" style="width: 87%"></div>
        </div>
    </div>

    <!-- Response Time -->
    <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-4 border border-gray-700/50">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-400 text-sm">Avg Response Time</p>
                <p class="text-white font-semibold text-lg">2.4 hours</p>
            </div>
            <div class="w-10 h-10 bg-green-500/20 rounded-full flex items-center justify-center">
                <i class="fas fa-bolt text-green-400"></i>
            </div>
        </div>
        <div class="w-full bg-gray-700 rounded-full h-2 mt-2">
            <div class="bg-green-500 h-2 rounded-full" style="width: 76%"></div>
        </div>
    </div>

    <!-- Resolution Rate -->
    <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-4 border border-gray-700/50">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-400 text-sm">Resolution Rate</p>
                <p class="text-white font-semibold text-lg">94%</p>
            </div>
            <div class="w-10 h-10 bg-purple-500/20 rounded-full flex items-center justify-center">
                <i class="fas fa-flag text-purple-400"></i>
            </div>
        </div>
        <div class="w-full bg-gray-700 rounded-full h-2 mt-2">
            <div class="bg-purple-500 h-2 rounded-full" style="width: 94%"></div>
        </div>
    </div>
</div>
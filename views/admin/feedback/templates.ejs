<%- include('../layouts/admin-base') %>

<div class="p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white mb-2">Response Templates</h1>
            <p class="text-gray-400">Manage pre-defined responses for common feedback scenarios</p>
        </div>
        <button class="bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-600 hover:to-blue-600 text-white px-6 py-2.5 rounded-xl font-medium transition-all duration-300 transform hover:scale-105">
            <i class="fas fa-plus mr-2"></i>New Template
        </button>
    </div>

    <!-- Template Categories -->
    <div class="flex space-x-2 mb-6 overflow-x-auto pb-2">
        <button class="bg-cyan-500/20 text-cyan-400 border border-cyan-500/30 px-4 py-2 rounded-xl font-medium whitespace-nowrap transition-all duration-300">
            All Templates
        </button>
        <button class="bg-gray-700/50 hover:bg-gray-600/50 text-gray-300 border border-gray-600/50 px-4 py-2 rounded-xl font-medium whitespace-nowrap transition-all duration-300">
            Bug Reports
        </button>
        <button class="bg-gray-700/50 hover:bg-gray-600/50 text-gray-300 border border-gray-600/50 px-4 py-2 rounded-xl font-medium whitespace-nowrap transition-all duration-300">
            Feature Requests
        </button>
        <button class="bg-gray-700/50 hover:bg-gray-600/50 text-gray-300 border border-gray-600/50 px-4 py-2 rounded-xl font-medium whitespace-nowrap transition-all duration-300">
            General Support
        </button>
        <button class="bg-gray-700/50 hover:bg-gray-600/50 text-gray-300 border border-gray-600/50 px-4 py-2 rounded-xl font-medium whitespace-nowrap transition-all duration-300">
            Positive Feedback
        </button>
    </div>

    <!-- Templates Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Template Card 1 -->
        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50 hover:border-cyan-500/30 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-white group-hover:text-cyan-400 transition-colors duration-300">Bug Acknowledgment</h3>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-500/20 text-red-400 border border-red-500/30 mt-1">
                        Bug Report
                    </span>
                </div>
                <div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                        <i class="fas fa-edit text-xs"></i>
                    </button>
                    <button class="w-8 h-8 bg-red-500/20 hover:bg-red-500/30 border border-red-500/30 rounded-lg flex items-center justify-center text-red-400 transition-all duration-300">
                        <i class="fas fa-trash text-xs"></i>
                    </button>
                </div>
            </div>
            <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                Thank you for reporting this issue. We've identified the problem and our team is working on a fix. We'll update you once it's resolved.
            </p>
            <div class="flex items-center justify-between text-xs text-gray-500">
                <span>Used 247 times</span>
                <span>Last used: 2 hours ago</span>
            </div>
        </div>

        <!-- Template Card 2 -->
        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50 hover:border-green-500/30 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-white group-hover:text-green-400 transition-colors duration-300">Feature Request</h3>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400 border border-blue-500/30 mt-1">
                        Feature
                    </span>
                </div>
                <div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                        <i class="fas fa-edit text-xs"></i>
                    </button>
                    <button class="w-8 h-8 bg-red-500/20 hover:bg-red-500/30 border border-red-500/30 rounded-lg flex items-center justify-center text-red-400 transition-all duration-300">
                        <i class="fas fa-trash text-xs"></i>
                    </button>
                </div>
            </div>
            <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                We appreciate your feature suggestion! Our product team will review this and consider it for future updates. Thank you for helping us improve.
            </p>
            <div class="flex items-center justify-between text-xs text-gray-500">
                <span>Used 189 times</span>
                <span>Last used: 1 day ago</span>
            </div>
        </div>

        <!-- Template Card 3 -->
        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50 hover:border-purple-500/30 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-white group-hover:text-purple-400 transition-colors duration-300">Positive Feedback</h3>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-500/20 text-green-400 border border-green-500/30 mt-1">
                        Positive
                    </span>
                </div>
                <div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                        <i class="fas fa-edit text-xs"></i>
                    </button>
                    <button class="w-8 h-8 bg-red-500/20 hover:bg-red-500/30 border border-red-500/30 rounded-lg flex items-center justify-center text-red-400 transition-all duration-300">
                        <i class="fas fa-trash text-xs"></i>
                    </button>
                </div>
            </div>
            <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                Thank you for your kind words! We're thrilled to hear you're enjoying our product. Your feedback motivates our team to keep delivering great experiences.
            </p>
            <div class="flex items-center justify-between text-xs text-gray-500">
                <span>Used 156 times</span>
                <span>Last used: 3 hours ago</span>
            </div>
        </div>

        <!-- Template Card 4 -->
        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50 hover:border-orange-500/30 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-white group-hover:text-orange-400 transition-colors duration-300">Support Follow-up</h3>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-purple-500/20 text-purple-400 border border-purple-500/30 mt-1">
                        Support
                    </span>
                </div>
                <div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                        <i class="fas fa-edit text-xs"></i>
                    </button>
                    <button class="w-8 h-8 bg-red-500/20 hover:bg-red-500/30 border border-red-500/30 rounded-lg flex items-center justify-center text-red-400 transition-all duration-300">
                        <i class="fas fa-trash text-xs"></i>
                    </button>
                </div>
            </div>
            <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                We're following up on your recent support request. Has your issue been resolved? If you need further assistance, please don't hesitate to reach out.
            </p>
            <div class="flex items-center justify-between text-xs text-gray-500">
                <span>Used 98 times</span>
                <span>Last used: 5 hours ago</span>
            </div>
        </div>

        <!-- Template Card 5 -->
        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50 hover:border-yellow-500/30 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-white group-hover:text-yellow-400 transition-colors duration-300">Escalation Notice</h3>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-orange-500/20 text-orange-400 border border-orange-500/30 mt-1">
                        Escalation
                    </span>
                </div>
                <div class="flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                        <i class="fas fa-edit text-xs"></i>
                    </button>
                    <button class="w-8 h-8 bg-red-500/20 hover:bg-red-500/30 border border-red-500/30 rounded-lg flex items-center justify-center text-red-400 transition-all duration-300">
                        <i class="fas fa-trash text-xs"></i>
                    </button>
                </div>
            </div>
            <p class="text-gray-400 text-sm mb-4 line-clamp-3">
                We've escalated your issue to our senior technical team for further investigation. They'll provide a comprehensive solution within 24-48 hours.
            </p>
            <div class="flex items-center justify-between text-xs text-gray-500">
                <span>Used 67 times</span>
                <span>Last used: 2 days ago</span>
            </div>
        </div>

        <!-- Add New Template Card -->
        <div class="bg-gray-800/10 backdrop-blur-xl rounded-2xl p-6 border-2 border-dashed border-gray-600/30 hover:border-cyan-500/50 hover:bg-cyan-500/5 transition-all duration-300 group cursor-pointer">
            <div class="flex flex-col items-center justify-center h-full text-center py-8">
                <div class="w-16 h-16 bg-cyan-500/20 rounded-full flex items-center justify-center text-cyan-400 mb-4 group-hover:scale-110 transition-transform duration-300">
                    <i class="fas fa-plus text-2xl"></i>
                </div>
                <h3 class="text-lg font-semibold text-white mb-2">Create New Template</h3>
                <p class="text-gray-400 text-sm">Add a new response template for common scenarios</p>
            </div>
        </div>
    </div>
</div>

<style>
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
<%- include('../layouts/admin-base') %>

<div class="p-6">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-3xl font-bold text-white mb-2">Feedback Assignments</h1>
            <p class="text-gray-400">Assign feedback to team members and track progress</p>
        </div>
        <button class="bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-600 hover:to-blue-600 text-white px-6 py-2.5 rounded-xl font-medium transition-all duration-300 transform hover:scale-105">
            <i class="fas fa-user-plus mr-2"></i>Assign Feedback
        </button>
    </div>

    <!-- Team Performance Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-gradient-to-br from-cyan-500/10 to-blue-500/10 backdrop-blur-xl rounded-2xl p-6 border border-cyan-500/20">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-cyan-400 text-sm font-medium">Active Assignments</p>
                    <p class="text-2xl font-bold text-white mt-2">47</p>
                </div>
                <div class="w-12 h-12 bg-cyan-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-tasks text-cyan-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-green-500/10 to-emerald-500/10 backdrop-blur-xl rounded-2xl p-6 border border-green-500/20">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-green-400 text-sm font-medium">Completed Today</p>
                    <p class="text-2xl font-bold text-white mt-2">23</p>
                </div>
                <div class="w-12 h-12 bg-green-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-check-circle text-green-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-orange-500/10 to-red-500/10 backdrop-blur-xl rounded-2xl p-6 border border-orange-500/20">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-orange-400 text-sm font-medium">Overdue</p>
                    <p class="text-2xl font-bold text-white mt-2">8</p>
                </div>
                <div class="w-12 h-12 bg-orange-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-clock text-orange-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-purple-500/10 to-pink-500/10 backdrop-blur-xl rounded-2xl p-6 border border-purple-500/20">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-purple-400 text-sm font-medium">Avg Response Time</p>
                    <p class="text-2xl font-bold text-white mt-2">2.1h</p>
                </div>
                <div class="w-12 h-12 bg-purple-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-bolt text-purple-400 text-xl"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Team Members -->
        <div class="lg:col-span-1">
            <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
                <h3 class="text-xl font-semibold text-white mb-4">Team Members</h3>
                <div class="space-y-4">
                    <!-- Team Member 1 -->
                    <div class="flex items-center justify-between p-3 bg-gray-700/30 rounded-xl border border-gray-600/30 hover:border-cyan-500/30 transition-all duration-300">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                SJ
                            </div>
                            <div>
                                <p class="text-white font-medium">Sarah Johnson</p>
                                <p class="text-gray-400 text-xs">Support Specialist</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-white font-medium">12</p>
                            <p class="text-gray-400 text-xs">Active</p>
                        </div>
                    </div>

                    <!-- Team Member 2 -->
                    <div class="flex items-center justify-between p-3 bg-gray-700/30 rounded-xl border border-gray-600/30 hover:border-green-500/30 transition-all duration-300">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                MK
                            </div>
                            <div>
                                <p class="text-white font-medium">Mike Chen</p>
                                <p class="text-gray-400 text-xs">Technical Support</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-white font-medium">8</p>
                            <p class="text-gray-400 text-xs">Active</p>
                        </div>
                    </div>

                    <!-- Team Member 3 -->
                    <div class="flex items-center justify-between p-3 bg-gray-700/30 rounded-xl border border-gray-600/30 hover:border-purple-500/30 transition-all duration-300">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                EP
                            </div>
                            <div>
                                <p class="text-white font-medium">Emily Parker</p>
                                <p class="text-gray-400 text-xs">Customer Success</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-white font-medium">15</p>
                            <p class="text-gray-400 text-xs">Active</p>
                        </div>
                    </div>

                    <!-- Team Member 4 -->
                    <div class="flex items-center justify-between p-3 bg-gray-700/30 rounded-xl border border-gray-600/30 hover:border-orange-500/30 transition-all duration-300">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-gradient-to-r from-orange-500 to-red-500 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                DR
                            </div>
                            <div>
                                <p class="text-white font-medium">David Rodriguez</p>
                                <p class="text-gray-400 text-xs">Support Lead</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-white font-medium">6</p>
                            <p class="text-gray-400 text-xs">Active</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assignments List -->
        <div class="lg:col-span-2">
            <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl border border-gray-700/50 overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-700/50">
                    <h3 class="text-xl font-semibold text-white">Recent Assignments</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-gray-700/50">
                                <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Feedback</th>
                                <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Assigned To</th>
                                <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Due Date</th>
                                <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-4 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-700/30">
                            <!-- Assignment 1 -->
                            <tr class="hover:bg-gray-700/20 transition-all duration-300">
                                <td class="px-6 py-4">
                                    <div>
                                        <p class="text-white font-medium">Login page loading too slow</p>
                                        <p class="text-gray-400 text-sm mt-1">#FB-1247</p>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-8 h-8 bg-gradient-to-r from-cyan-500 to-blue-500 rounded-full flex items-center justify-center text-white text-xs font-bold">
                                            SJ
                                        </div>
                                        <span class="text-white">Sarah Johnson</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-white">Today, 5:00 PM</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-orange-500/20 text-orange-400 border border-orange-500/30">
                                        <i class="fas fa-clock mr-1"></i>In Progress
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex space-x-2">
                                        <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                                            <i class="fas fa-eye text-xs"></i>
                                        </button>
                                        <button class="w-8 h-8 bg-green-500/20 hover:bg-green-500/30 border border-green-500/30 rounded-lg flex items-center justify-center text-green-400 transition-all duration-300">
                                            <i class="fas fa-edit text-xs"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Assignment 2 -->
                            <tr class="hover:bg-gray-700/20 transition-all duration-300">
                                <td class="px-6 py-4">
                                    <div>
                                        <p class="text-white font-medium">Feature request: Dark mode</p>
                                        <p class="text-gray-400 text-sm mt-1">#FB-1246</p>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-8 h-8 bg-gradient-to-r from-green-500 to-emerald-500 rounded-full flex items-center justify-center text-white text-xs font-bold">
                                            MK
                                        </div>
                                        <span class="text-white">Mike Chen</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-white">Tomorrow, 10:00 AM</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400 border border-blue-500/30">
                                        <i class="fas fa-list-alt mr-1"></i>Pending Review
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex space-x-2">
                                        <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                                            <i class="fas fa-eye text-xs"></i>
                                        </button>
                                        <button class="w-8 h-8 bg-green-500/20 hover:bg-green-500/30 border border-green-500/30 rounded-lg flex items-center justify-center text-green-400 transition-all duration-300">
                                            <i class="fas fa-edit text-xs"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            <!-- Assignment 3 -->
                            <tr class="hover:bg-gray-700/20 transition-all duration-300">
                                <td class="px-6 py-4">
                                    <div>
                                        <p class="text-white font-medium">Payment gateway issue</p>
                                        <p class="text-gray-400 text-sm mt-1">#FB-1245</p>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-8 h-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-full flex items-center justify-center text-white text-xs font-bold">
                                            EP
                                        </div>
                                        <span class="text-white">Emily Parker</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-red-400">Overdue</span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-500/20 text-red-400 border border-red-500/30">
                                        <i class="fas fa-exclamation-triangle mr-1"></i>Overdue
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex space-x-2">
                                        <button class="w-8 h-8 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-lg flex items-center justify-center text-cyan-400 transition-all duration-300">
                                            <i class="fas fa-eye text-xs"></i>
                                        </button>
                                        <button class="w-8 h-8 bg-green-500/20 hover:bg-green-500/30 border border-green-500/30 rounded-lg flex items-center justify-center text-green-400 transition-all duration-300">
                                            <i class="fas fa-edit text-xs"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin/feedback/assignments.js"></script>
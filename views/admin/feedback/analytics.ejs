<%- include('../layouts/admin-base') %>

<div class="p-6">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">Feedback Analytics</h1>
        <p class="text-gray-400">Deep insights into customer feedback patterns and trends</p>
    </div>

    <!-- Main Analytics Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        <!-- Left Column - Charts -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Rating Distribution -->
            <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-xl font-semibold text-white">Rating Distribution</h3>
                    <select class="bg-gray-700/50 border border-gray-600/50 rounded-xl px-3 py-1 text-white text-sm">
                        <option>Last 7 days</option>
                        <option>Last 30 days</option>
                        <option>Last 90 days</option>
                    </select>
                </div>
                <div class="flex items-end justify-between h-48">
                    <!-- Star 1 -->
                    <div class="flex flex-col items-center">
                        <div class="w-12 bg-gradient-to-t from-red-500 to-red-600 rounded-t-lg mb-2" style="height: 40px;"></div>
                        <div class="flex text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="text-white text-sm mt-1">12</span>
                    </div>
                    <!-- Star 2 -->
                    <div class="flex flex-col items-center">
                        <div class="w-12 bg-gradient-to-t from-orange-500 to-orange-600 rounded-t-lg mb-2" style="height: 80px;"></div>
                        <div class="flex text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="text-white text-sm mt-1">45</span>
                    </div>
                    <!-- Star 3 -->
                    <div class="flex flex-col items-center">
                        <div class="w-12 bg-gradient-to-t from-yellow-500 to-yellow-600 rounded-t-lg mb-2" style="height: 120px;"></div>
                        <div class="flex text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="text-white text-sm mt-1">89</span>
                    </div>
                    <!-- Star 4 -->
                    <div class="flex flex-col items-center">
                        <div class="w-12 bg-gradient-to-t from-green-500 to-green-600 rounded-t-lg mb-2" style="height: 160px;"></div>
                        <div class="flex text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="text-white text-sm mt-1">156</span>
                    </div>
                    <!-- Star 5 -->
                    <div class="flex flex-col items-center">
                        <div class="w-12 bg-gradient-to-t from-emerald-500 to-emerald-600 rounded-t-lg mb-2" style="height: 200px;"></div>
                        <div class="flex text-yellow-400 text-sm">
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="text-white text-sm mt-1">234</span>
                    </div>
                </div>
            </div>

            <!-- Feedback Trends -->
            <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
                <h3 class="text-xl font-semibold text-white mb-6">Feedback Trends</h3>
                <div class="flex items-end space-x-2 h-40">
                    <div class="flex-1 flex flex-col items-center">
                        <div class="w-full bg-gradient-to-t from-cyan-500 to-cyan-600 rounded-t-lg" style="height: 60px;"></div>
                        <span class="text-gray-400 text-xs mt-2">Mon</span>
                    </div>
                    <div class="flex-1 flex flex-col items-center">
                        <div class="w-full bg-gradient-to-t from-cyan-500 to-cyan-600 rounded-t-lg" style="height: 90px;"></div>
                        <span class="text-gray-400 text-xs mt-2">Tue</span>
                    </div>
                    <div class="flex-1 flex flex-col items-center">
                        <div class="w-full bg-gradient-to-t from-cyan-500 to-cyan-600 rounded-t-lg" style="height: 120px;"></div>
                        <span class="text-gray-400 text-xs mt-2">Wed</span>
                    </div>
                    <div class="flex-1 flex flex-col items-center">
                        <div class="w-full bg-gradient-to-t from-cyan-500 to-cyan-600 rounded-t-lg" style="height: 80px;"></div>
                        <span class="text-gray-400 text-xs mt-2">Thu</span>
                    </div>
                    <div class="flex-1 flex flex-col items-center">
                        <div class="w-full bg-gradient-to-t from-cyan-500 to-cyan-600 rounded-t-lg" style="height: 150px;"></div>
                        <span class="text-gray-400 text-xs mt-2">Fri</span>
                    </div>
                    <div class="flex-1 flex flex-col items-center">
                        <div class="w-full bg-gradient-to-t from-cyan-500 to-cyan-600 rounded-t-lg" style="height: 100px;"></div>
                        <span class="text-gray-400 text-xs mt-2">Sat</span>
                    </div>
                    <div class="flex-1 flex flex-col items-center">
                        <div class="w-full bg-gradient-to-t from-cyan-500 to-cyan-600 rounded-t-lg" style="height: 70px;"></div>
                        <span class="text-gray-400 text-xs mt-2">Sun</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Stats -->
        <div class="space-y-6">
            <!-- Response Time -->
            <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
                <h3 class="text-xl font-semibold text-white mb-4">Average Response Time</h3>
                <div class="text-center">
                    <div class="inline-flex items-center justify-center w-32 h-32 bg-gradient-to-br from-cyan-500/10 to-blue-500/10 rounded-full border border-cyan-500/20 mb-4">
                        <span class="text-3xl font-bold text-white">2.4h</span>
                    </div>
                    <p class="text-green-400 text-sm">↓ 15% from last week</p>
                </div>
            </div>

            <!-- Category Distribution -->
            <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
                <h3 class="text-xl font-semibold text-white mb-4">Category Distribution</h3>
                <div class="space-y-4">
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">Bug Reports</span>
                            <span class="text-white font-medium">35%</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-red-500 h-2 rounded-full" style="width: 35%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">Feature Requests</span>
                            <span class="text-white font-medium">28%</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-blue-500 h-2 rounded-full" style="width: 28%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">General Feedback</span>
                            <span class="text-white font-medium">22%</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-green-500 h-2 rounded-full" style="width: 22%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="flex justify-between text-sm mb-1">
                            <span class="text-gray-300">Support</span>
                            <span class="text-white font-medium">15%</span>
                        </div>
                        <div class="w-full bg-gray-700 rounded-full h-2">
                            <div class="bg-purple-500 h-2 rounded-full" style="width: 15%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-cyan-400 text-sm font-medium">Satisfaction Score</p>
                    <p class="text-2xl font-bold text-white mt-2">8.7/10</p>
                </div>
                <div class="w-12 h-12 bg-cyan-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-smile text-cyan-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-green-400 text-sm font-medium">Resolution Rate</p>
                    <p class="text-2xl font-bold text-white mt-2">94%</p>
                </div>
                <div class="w-12 h-12 bg-green-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-flag text-green-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-purple-400 text-sm font-medium">Feedback Volume</p>
                    <p class="text-2xl font-bold text-white mt-2">247/wk</p>
                </div>
                <div class="w-12 h-12 bg-purple-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-chart-line text-purple-400 text-xl"></i>
                </div>
            </div>
        </div>

        <div class="bg-gray-800/30 backdrop-blur-xl rounded-2xl p-6 border border-gray-700/50">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-orange-400 text-sm font-medium">Active Issues</p>
                    <p class="text-2xl font-bold text-white mt-2">18</p>
                </div>
                <div class="w-12 h-12 bg-orange-500/20 rounded-full flex items-center justify-center">
                    <i class="fas fa-exclamation-triangle text-orange-400 text-xl"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/admin/feedback/analytics.js"></script>
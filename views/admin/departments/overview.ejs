<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Department Overview | Enterprise CRM</title>
    
    <!-- Premium Assets -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --success-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --warning-gradient: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --danger-gradient: linear-gradient(135deg, #ff6b6b 0%, #ffa8a8 100%);
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .glassmorphism {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            border-left: 5px solid;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .stat-card.primary { border-left-color: #667eea; }
        .stat-card.success { border-left-color: #4facfe; }
        .stat-card.warning { border-left-color: #fa709a; }
        .stat-card.danger { border-left-color: #ff6b6b; }
        .stat-card.info { border-left-color: #00f2fe; }
        .stat-card.secondary { border-left-color: #764ba2; }

        .metric-value {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0;
        }

        .metric-label {
            font-size: 0.9rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .progress-3d {
            height: 10px;
            border-radius: 10px;
            background: linear-gradient(90deg, #e0e0e0, #f5f5f5);
            overflow: hidden;
            position: relative;
        }

        .progress-3d::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .team-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 1.1rem;
        }

        .quick-action-btn {
            background: rgba(255, 255, 255, 0.9);
            border: none;
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .quick-action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            background: white;
        }

        .activity-item {
            padding: 15px;
            border-left: 3px solid #667eea;
            background: rgba(255, 255, 255, 0.9);
            margin-bottom: 10px;
            border-radius: 0 10px 10px 0;
            transition: all 0.3s ease;
        }

        .activity-item:hover {
            transform: translateX(5px);
            background: white;
        }

        .chart-container {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .floating-stats {
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.95);
            padding: 15px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }
    </style>
</head>
<body>
    <div class="container-fluid py-4">
        <!-- Header with Floating Stats -->
        <div class="floating-stats">
            <div class="d-flex align-items-center">
                <div class="team-avatar me-3" id="deptInitials">D</div>
                <div>
                    <h6 class="mb-0 fw-bold" id="deptName">Department</h6>
                    <small class="text-muted" id="deptCode">CODE</small>
                </div>
            </div>
        </div>

        <!-- Main Header -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="glassmorphism p-5 text-white text-center">
                    <h1 class="display-4 fw-bold mb-3" id="mainDeptName">Department Overview</h1>
                    <p class="lead mb-4" id="deptDescription">Loading department information...</p>
                    <div class="row justify-content-center">
                        <div class="col-auto">
                            <span class="badge bg-success bg-opacity-25 text-success fs-6 px-3 py-2">
                                <i class="fas fa-circle me-2"></i>
                                <span id="deptStatus">Loading...</span>
                            </span>
                        </div>
                        <div class="col-auto">
                            <span class="badge bg-primary bg-opacity-25 text-primary fs-6 px-3 py-2">
                                <i class="fas fa-users me-2"></i>
                                <span id="deptEmployeeCount">0</span> Team Members
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats Row -->
        <div class="row mb-4">
            <div class="col-xl-2 col-md-4 col-6">
                <div class="stat-card primary">
                    <div class="metric-value text-primary" id="teamSize">0</div>
                    <div class="metric-label">Team Size</div>
                    <div class="progress-3d mt-2">
                        <div class="progress-bar bg-primary" style="width: 75%"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-6">
                <div class="stat-card success">
                    <div class="metric-value text-success" id="performanceScore">0%</div>
                    <div class="metric-label">Performance</div>
                    <div class="progress-3d mt-2">
                        <div class="progress-bar bg-success" style="width: 85%"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-6">
                <div class="stat-card warning">
                    <div class="metric-value text-warning" id="budgetUsed">$0</div>
                    <div class="metric-label">Budget Used</div>
                    <div class="progress-3d mt-2">
                        <div class="progress-bar bg-warning" style="width: 65%"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-6">
                <div class="stat-card danger">
                    <div class="metric-value text-danger" id="attendanceRate">0%</div>
                    <div class="metric-label">Attendance</div>
                    <div class="progress-3d mt-2">
                        <div class="progress-bar bg-danger" style="width: 90%"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-6">
                <div class="stat-card info">
                    <div class="metric-value text-info" id="projectCount">0</div>
                    <div class="metric-label">Projects</div>
                    <div class="progress-3d mt-2">
                        <div class="progress-bar bg-info" style="width: 60%"></div>
                    </div>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-6">
                <div class="stat-card secondary">
                    <div class="metric-value text-secondary" id="healthScore">0</div>
                    <div class="metric-label">Health Score</div>
                    <div class="progress-3d mt-2">
                        <div class="progress-bar bg-secondary" style="width: 80%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Left Column - Charts & Details -->
            <div class="col-lg-8">
                <!-- Performance Charts -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="chart-container">
                            <h5 class="fw-bold mb-4">
                                <i class="fas fa-chart-line text-primary me-2"></i>
                                Performance Trends
                            </h5>
                            <canvas id="performanceChart" height="250"></canvas>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="chart-container">
                            <h5 class="fw-bold mb-4">
                                <i class="fas fa-chart-pie text-success me-2"></i>
                                Budget Distribution
                            </h5>
                            <canvas id="budgetChart" height="250"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Department Details -->
                <div class="chart-container mb-4">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-info-circle text-info me-2"></i>
                        Department Information
                    </h5>
                    <div class="row">
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted" width="40%">Department Code:</td>
                                    <td><strong id="detailCode">-</strong></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Manager:</td>
                                    <td id="detailManager">-</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Parent Department:</td>
                                    <td id="detailParent">-</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Status:</td>
                                    <td><span class="badge bg-success" id="detailStatus">Active</span></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted" width="40%">Created:</td>
                                    <td id="detailCreated">-</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Budget Allocated:</td>
                                    <td><strong id="detailBudget">$0</strong></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Budget Utilization:</td>
                                    <td>
                                        <div class="progress-3d">
                                            <div id="detailProgress" class="progress-bar" style="width: 0%"></div>
                                        </div>
                                        <small class="text-muted" id="detailUtilization">0%</small>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Description:</td>
                                    <td id="detailDescription">-</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column - Team & Actions -->
            <div class="col-lg-4">
                <!-- Team Members -->
                <div class="chart-container mb-4">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-users text-success me-2"></i>
                        Team Members
                        <span class="badge bg-success ms-2" id="teamCount">0</span>
                    </h5>
                    <div id="teamList" class="mb-3">
                        <!-- Team members will be loaded here -->
                    </div>
                    <button class="btn btn-outline-success w-100" onclick="viewAllEmployees()">
                        <i class="fas fa-eye me-2"></i>View All Team Members
                    </button>
                </div>

                <!-- Quick Actions -->
                <div class="chart-container mb-4">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-bolt text-warning me-2"></i>
                        Quick Actions
                    </h5>
                    <div class="row g-2">
                        <div class="col-6">
                            <button class="quick-action-btn w-100" onclick="addEmployee()">
                                <i class="fas fa-user-plus text-primary fa-2x mb-2"></i>
                                <div>Add Employee</div>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="quick-action-btn w-100" onclick="manageBudget()">
                                <i class="fas fa-money-bill-wave text-success fa-2x mb-2"></i>
                                <div>Manage Budget</div>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="quick-action-btn w-100" onclick="viewReports()">
                                <i class="fas fa-chart-pie text-info fa-2x mb-2"></i>
                                <div>View Reports</div>
                            </button>
                        </div>
                        <div class="col-6">
                            <button class="quick-action-btn w-100" onclick="departmentSettings()">
                                <i class="fas fa-cog text-secondary fa-2x mb-2"></i>
                                <div>Settings</div>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="chart-container">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-history text-secondary me-2"></i>
                        Recent Activity
                    </h5>
                    <div id="recentActivity">
                        <!-- Activity items will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Premium Overview JavaScript
        class PremiumDepartmentOverview {
            constructor() {
                this.departmentId = new URLSearchParams(window.location.search).get('id');
                this.init();
            }

            async init() {
                await this.loadDepartmentData();
                this.initializeCharts();
                this.startLiveUpdates();
            }

            async loadDepartmentData() {
                try {
                    const response = await fetch(`/api/admin/departments/${this.departmentId}?include=full`);
                    const result = await response.json();

                    if (result.success) {
                        this.renderDepartmentData(result.data);
                    } else {
                        this.showError('Failed to load department data');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    this.showError('Error loading department overview');
                }
            }

            renderDepartmentData(data) {
                // Update header information
                document.getElementById('mainDeptName').textContent = data.name;
                document.getElementById('deptName').textContent = data.name;
                document.getElementById('deptInitials').textContent = data.name.charAt(0);
                document.getElementById('deptCode').textContent = data.code;
                document.getElementById('deptDescription').textContent = data.description || 'No description provided';
                document.getElementById('deptStatus').textContent = data.status;
                document.getElementById('deptEmployeeCount').textContent = data.metrics.employeeCount || 0;

                // Update quick stats
                document.getElementById('teamSize').textContent = data.metrics.employeeCount || 0;
                document.getElementById('performanceScore').textContent = (data.metrics.performanceScore || 0) + '%';
                document.getElementById('budgetUsed').textContent = '$' + (data.budget.utilized || 0).toLocaleString();
                document.getElementById('attendanceRate').textContent = '95%';
                document.getElementById('projectCount').textContent = '12';
                document.getElementById('healthScore').textContent = '78';

                // Update details
                document.getElementById('detailCode').textContent = data.code;
                document.getElementById('detailManager').textContent = data.manager ? 
                    `${data.manager.firstName} ${data.manager.lastName}` : 'Not assigned';
                document.getElementById('detailParent').textContent = data.parentDepartment ? 
                    data.parentDepartment.name : 'None';
                document.getElementById('detailCreated').textContent = new Date(data.createdAt).toLocaleDateString();
                document.getElementById('detailBudget').textContent = '$' + (data.budget.allocated || 0).toLocaleString();
                document.getElementById('detailDescription').textContent = data.description || 'No description';

                const utilization = data.budget.utilizationPercentage || 0;
                const progressBar = document.getElementById('detailProgress');
                progressBar.style.width = utilization + '%';
                progressBar.className = 'progress-bar ' + (
                    utilization < 50 ? 'bg-success' : 
                    utilization < 80 ? 'bg-warning' : 'bg-danger'
                );
                document.getElementById('detailUtilization').textContent = utilization + '% utilized';

                // Status badge
                const statusBadge = document.getElementById('detailStatus');
                statusBadge.textContent = data.status;
                statusBadge.className = 'badge ' + (
                    data.status === 'active' ? 'bg-success' :
                    data.status === 'inactive' ? 'bg-warning' : 'bg-secondary'
                );

                // Load team members and activity
                this.loadTeamMembers();
                this.loadRecentActivity();
            }

            initializeCharts() {
                // Performance Chart
                const perfCtx = document.getElementById('performanceChart').getContext('2d');
                new Chart(perfCtx, {
                    type: 'line',
                    data: {
                        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                        datasets: [{
                            label: 'Performance Score',
                            data: [65, 70, 68, 75, 80, 78, 82],
                            borderColor: '#667eea',
                            backgroundColor: 'rgba(102, 126, 234, 0.1)',
                            tension: 0.4,
                            fill: true,
                            borderWidth: 3
                        }]
                    },
                    options: {
                        responsive: true,
                        plugins: {
                            legend: {
                                display: false
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 100,
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            },
                            x: {
                                grid: {
                                    color: 'rgba(0, 0, 0, 0.1)'
                                }
                            }
                        }
                    }
                });

                // Budget Chart
                const budgetCtx = document.getElementById('budgetChart').getContext('2d');
                new Chart(budgetCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Utilized', 'Remaining'],
                        datasets: [{
                            data: [65, 35],
                            backgroundColor: ['#ff6b6b', '#4facfe'],
                            borderWidth: 2,
                            borderColor: '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'bottom'
                            }
                        }
                    }
                });
            }

            loadTeamMembers() {
                const mockTeam = [
                    { name: 'John Doe', position: 'Senior Developer', initial: 'J' },
                    { name: 'Jane Smith', position: 'Project Manager', initial: 'J' },
                    { name: 'Mike Johnson', position: 'UI/UX Designer', initial: 'M' },
                    { name: 'Sarah Wilson', position: 'QA Engineer', initial: 'S' }
                ];

                let html = '';
                mockTeam.forEach(member => {
                    html += `
                        <div class="d-flex align-items-center mb-3">
                            <div class="team-avatar me-3">
                                ${member.initial}
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0 fw-semibold">${member.name}</h6>
                                <small class="text-muted">${member.position}</small>
                            </div>
                            <span class="badge bg-success">Active</span>
                        </div>
                    `;
                });

                document.getElementById('teamList').innerHTML = html;
                document.getElementById('teamCount').textContent = mockTeam.length;
            }

            loadRecentActivity() {
                const activities = [
                    { action: 'New employee joined the team', time: '2 hours ago', icon: 'user-plus', color: 'success' },
                    { action: 'Performance review completed', time: '1 day ago', icon: 'chart-line', color: 'primary' },
                    { action: 'Budget allocation updated', time: '2 days ago', icon: 'dollar-sign', color: 'warning' },
                    { action: 'Project milestone achieved', time: '3 days ago', icon: 'flag', color: 'info' }
                ];

                let html = '';
                activities.forEach(activity => {
                    html += `
                        <div class="activity-item">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-${activity.icon} text-${activity.color} mt-1"></i>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <p class="mb-1 small">${activity.action}</p>
                                    <small class="text-muted">${activity.time}</small>
                                </div>
                            </div>
                        </div>
                    `;
                });

                document.getElementById('recentActivity').innerHTML = html;
            }

            startLiveUpdates() {
                // Simulate live data updates
                setInterval(() => {
                    this.updateLiveStats();
                }, 10000);
            }

            updateLiveStats() {
                // Update stats with slight variations
                const performance = document.getElementById('performanceScore');
                const currentPerf = parseInt(performance.textContent);
                performance.textContent = Math.min(100, Math.max(0, currentPerf + (Math.random() * 4 - 2))) + '%';

                const health = document.getElementById('healthScore');
                const currentHealth = parseInt(health.textContent);
                health.textContent = Math.min(100, Math.max(0, currentHealth + (Math.random() * 3 - 1.5)));
            }

            showError(message) {
                // Simple error display
                console.error(message);
            }
        }

        // Action functions
        function viewAllEmployees() {
            window.location.href = `/admin/employees?department=${premiumOverview.departmentId}`;
        }

        function addEmployee() {
            alert('Add employee functionality would open here');
        }

        function manageBudget() {
            alert('Budget management would open here');
        }

        function viewReports() {
            window.location.href = `/admin/departments/analytics?id=${premiumOverview.departmentId}`;
        }

        function departmentSettings() {
            alert('Department settings would open here');
        }

        // Initialize the premium overview
        const premiumOverview = new PremiumDepartmentOverview();
    </script>
</body>
</html>
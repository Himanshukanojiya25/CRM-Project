            updateAllCharts() {
                // Update all charts with new data
                Object.values(this.charts).forEach(chart => {
                    if (chart && typeof chart.update === 'function') {
                        chart.update();
                    }
                });
            }

            setupEventListeners() {
                // Time period filters
                document.querySelectorAll('.time-filter').forEach(button => {
                    button.addEventListener('click', (e) => {
                        document.querySelectorAll('.time-filter').forEach(btn => btn.classList.remove('active'));
                        e.target.classList.add('active');
                        this.currentPeriod = e.target.dataset.period;
                        this.loadAnalyticsData();
                    });
                });

                // Tab changes
                document.getElementById('analyticsTabs').addEventListener('shown.bs.tab', (e) => {
                    // Handle tab changes if needed
                });
            }

            startRealTimeUpdates() {
                // Simulate real-time data updates
                setInterval(() => {
                    this.updateRealTimeData();
                }, 15000);
            }

            updateRealTimeData() {
                // Update metrics with slight variations
                const metrics = ['performanceMetric', 'utilizationMetric', 'attendanceMetric'];
                metrics.forEach(metric => {
                    const element = document.getElementById(metric);
                    if (element) {
                        const currentValue = parseInt(element.textContent);
                        const variation = (Math.random() * 2 - 1); // -1 to +1
                        const newValue = Math.max(0, Math.min(100, currentValue + variation));
                        element.textContent = newValue.toFixed(0) + '%';
                    }
                });

                // Update health score
                const healthScore = document.getElementById('healthScore');
                if (healthScore) {
                    const currentHealth = parseInt(healthScore.textContent);
                    const newHealth = Math.max(0, Math.min(100, currentHealth + (Math.random() * 2 - 1)));
                    healthScore.textContent = Math.round(newHealth);
                    
                    // Update gauge
                    if (this.charts.healthGauge) {
                        this.charts.healthGauge.data.datasets[0].data = [newHealth, 100 - newHealth];
                        this.charts.healthGauge.update();
                    }
                }
            }


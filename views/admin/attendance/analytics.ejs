<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendance Analytics - Admin | CRM</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin/attendance.css">
    <style>
        /* Premium Analytics Styles */
        .analytics-container {
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .analytics-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            background: rgba(255, 255, 255, 0.95);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .analytics-header h1 {
            color: #2c3e50;
            margin: 0;
            font-size: 2.2rem;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .analytics-header h1 i {
            margin-right: 15px;
            font-size: 2.5rem;
        }

        .header-actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.95rem;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
        }

        .btn-secondary {
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
            color: white;
            box-shadow: 0 4px 15px rgba(149, 165, 166, 0.3);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        }

        /* Filter Tabs */
        .filter-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            background: rgba(255, 255, 255, 0.95);
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .filter-tab {
            padding: 15px 25px;
            background: rgba(255, 255, 255, 0.8);
            border: 2px solid transparent;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            color: #7f8c8d;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .filter-tab:hover {
            background: rgba(52, 152, 219, 0.1);
            color: #3498db;
            transform: translateY(-2px);
        }

        .filter-tab.active {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            border-color: #3498db;
            box-shadow: 0 4px 15px rgba(52, 152, 219, 0.3);
        }

        /* Insights Grid */
        .insights-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        .insight-card {
            background: rgba(255, 255, 255, 0.95);
            padding: 30px 25px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .insight-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
        }

        .insight-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

        .insight-card i {
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .insight-value {
            font-size: 2.8rem;
            font-weight: 800;
            margin: 15px 0;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .insight-card p {
            color: #7f8c8d;
            font-weight: 600;
            margin: 0 0 15px 0;
            font-size: 1rem;
        }

        .insight-trend {
            font-size: 0.85rem;
            padding: 6px 12px;
            border-radius: 20px;
            font-weight: 700;
            display: inline-block;
        }

        .trend-up { 
            background: linear-gradient(135deg, #d5f4e6, #27ae60);
            color: #27ae60;
        }
        .trend-down { 
            background: linear-gradient(135deg, #fdeaea, #e74c3c);
            color: #e74c3c;
        }

        /* Charts Grid */
        .charts-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
            gap: 25px;
            margin-bottom: 25px;
        }

        .chart-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 25px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: all 0.3s ease;
        }

        .chart-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(236, 240, 241, 0.5);
        }

        .chart-header h3 {
            margin: 0;
            color: #2c3e50;
            font-size: 1.3rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .chart-header h3 i {
            color: #3498db;
            font-size: 1.4rem;
        }

        .chart-header select {
            padding: 8px 15px;
            border: 2px solid #ecf0f1;
            border-radius: 10px;
            background: white;
            color: #2c3e50;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .chart-header select:hover {
            border-color: #3498db;
        }

        .chart-header select:focus {
            outline: none;
            border-color: #3498db;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        }

        .chart-container {
            height: 300px;
            position: relative;
        }

        /* Additional Analytics */
        .content-card {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.2);
            margin-bottom: 25px;
        }

        .card-body {
            padding: 25px;
        }

        /* Loading States */
        .chart-loading {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100%;
            color: #7f8c8d;
        }

        .chart-loading .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 15px;
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .charts-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .analytics-header {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
            
            .filter-tabs {
                flex-wrap: wrap;
                justify-content: center;
            }
            
            .insights-grid {
                grid-template-columns: 1fr;
            }
            
            .charts-grid {
                grid-template-columns: 1fr;
            }
            
            .chart-header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Notification Styles */
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 20px 25px;
            border-radius: 15px;
            color: white;
            z-index: 10000;
            animation: slideInRight 0.3s ease;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.2);
            max-width: 350px;
        }

        .notification-success { 
            background: linear-gradient(135deg, #27ae60, #2ecc71);
        }
        .notification-error { 
            background: linear-gradient(135deg, #e74c3c, #c0392b);
        }

        .notification-content {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        @keyframes slideInRight {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="analytics-container">
        <!-- Header -->
        <div class="analytics-header">
            <h1><i class="fas fa-chart-line"></i> Attendance Analytics</h1>
            <div class="header-actions">
                <button class="btn btn-primary" onclick="exportAnalyticsReport()">
                    <i class="fas fa-download"></i> Export Analytics
                </button>
                <button class="btn btn-secondary" onclick="refreshAnalytics()">
                    <i class="fas fa-sync"></i> Refresh
                </button>
            </div>
        </div>

        <!-- Time Filter Tabs -->
        <div class="filter-tabs">
            <button class="filter-tab <%= currentPeriod === 'week' ? 'active' : '' %>" onclick="setTimeFilter('week')">
                <i class="fas fa-calendar-week"></i> Weekly
            </button>
            <button class="filter-tab <%= currentPeriod === 'month' ? 'active' : '' %>" onclick="setTimeFilter('month')">
                <i class="fas fa-calendar-alt"></i> Monthly
            </button>
            <button class="filter-tab <%= currentPeriod === 'quarter' ? 'active' : '' %>" onclick="setTimeFilter('quarter')">
                <i class="fas fa-calendar"></i> Quarterly
            </button>
            <button class="filter-tab <%= currentPeriod === 'year' ? 'active' : '' %>" onclick="setTimeFilter('year')">
                <i class="fas fa-calendar-day"></i> Yearly
            </button>
        </div>

        <!-- Key Insights -->
        <div class="insights-grid">
            <div class="insight-card">
                <i class="fas fa-user-check" style="color: #27ae60;"></i>
                <div class="insight-value" id="avgAttendance">
                    <%= analyticsData && analyticsData.insights ? analyticsData.insights.averageAttendance + '%' : '85%' %>
                </div>
                <p>Average Attendance Rate</p>
                <span class="insight-trend trend-up" id="attendanceTrend">+2.5%</span>
            </div>
            <div class="insight-card">
                <i class="fas fa-clock" style="color: #f39c12;"></i>
                <div class="insight-value" id="avgHours">
                    <%= analyticsData && analyticsData.insights ? analyticsData.insights.averageHours + 'h' : '7.8h' %>
                </div>
                <p>Average Working Hours</p>
                <span class="insight-trend trend-up" id="hoursTrend">+0.3h</span>
            </div>
            <div class="insight-card">
                <i class="fas fa-user-times" style="color: #e74c3c;"></i>
                <div class="insight-value" id="absentRate">
                    <%= analyticsData && analyticsData.insights ? analyticsData.insights.absenteeismRate + '%' : '8%' %>
                </div>
                <p>Absenteeism Rate</p>
                <span class="insight-trend trend-down" id="absentTrend">-1.2%</span>
            </div>
            <div class="insight-card">
                <i class="fas fa-tachometer-alt" style="color: #3498db;"></i>
                <div class="insight-value" id="productivity">
                    <%= analyticsData && analyticsData.insights ? analyticsData.insights.productivity + '%' : '92%' %>
                </div>
                <p>Productivity Score</p>
                <span class="insight-trend trend-up" id="productivityTrend">+3.1%</span>
            </div>
        </div>

        <!-- Charts Grid -->
        <div class="charts-grid">
            <!-- Attendance Trend Chart -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3><i class="fas fa-chart-line"></i> Attendance Trends</h3>
                    <select id="trendMetric" onchange="updateTrendChart()">
                        <option value="attendance">Attendance Rate</option>
                        <option value="present">Present Count</option>
                        <option value="absent">Absent Count</option>
                    </select>
                </div>
                <div class="chart-container">
                    <canvas id="attendanceTrendChart"></canvas>
                </div>
            </div>

            <!-- Department Comparison -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3><i class="fas fa-building"></i> Department Performance</h3>
                </div>
                <div class="chart-container">
                    <canvas id="departmentChart"></canvas>
                </div>
            </div>

            <!-- Peak Hours Analysis -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3><i class="fas fa-clock"></i> Peak Hours</h3>
                </div>
                <div class="chart-container">
                    <canvas id="peakHoursChart"></canvas>
                </div>
            </div>

            <!-- Overtime Analysis -->
            <div class="chart-card">
                <div class="chart-header">
                    <h3><i class="fas fa-business-time"></i> Overtime Distribution</h3>
                </div>
                <div class="chart-container">
                    <canvas id="overtimeChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Additional Analytics -->
        <div class="content-card">
            <div class="card-header">
                <h3><i class="fas fa-chart-pie"></i> Detailed Analytics</h3>
            </div>
            <div class="card-body">
                <div class="charts-grid">
                    <div class="chart-card">
                        <div class="chart-header">
                            <h4><i class="fas fa-calendar-day"></i> Attendance by Day of Week</h4>
                        </div>
                        <div class="chart-container">
                            <canvas id="dayOfWeekChart"></canvas>
                        </div>
                    </div>
                    <div class="chart-card">
                        <div class="chart-header">
                            <h4><i class="fas fa-running"></i> Late Arrival Patterns</h4>
                        </div>
                        <div class="chart-container">
                            <canvas id="latePatternsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/admin/attendance-analytics.js"></script>

    <script>
        // Chart instances
        let trendChart, departmentChart, peakHoursChart, overtimeChart, dayOfWeekChart, latePatternsChart;
        let currentFilter = '<%= currentPeriod || "month" %>';

        // Initialize all charts
        function initializeAnalyticsCharts() {
            initializeTrendChart();
            initializeDepartmentChart();
            initializePeakHoursChart();
            initializeOvertimeChart();
            initializeDayOfWeekChart();
            initializeLatePatternsChart();
        }

        // Attendance Trend Chart
        function initializeTrendChart() {
            const ctx = document.getElementById('attendanceTrendChart');
            if (!ctx) return;

            // Sample data - Replace with actual data from backend
            const labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4'];
            const attendanceData = [85, 88, 82, 90];
            const presentData = [45, 48, 42, 50];
            const absentData = [8, 6, 10, 5];

            trendChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Attendance Rate %',
                        data: attendanceData,
                        borderColor: '#3498db',
                        backgroundColor: 'rgba(52, 152, 219, 0.1)',
                        tension: 0.4,
                        fill: true,
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Attendance Trend Over Time',
                            font: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                callback: function(value) {
                                    return value + '%';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Department Performance Chart
        function initializeDepartmentChart() {
            const ctx = document.getElementById('departmentChart');
            if (!ctx) return;

            const deptData = [
                { department: 'IT', attendance: 92 },
                { department: 'HR', attendance: 85 },
                { department: 'Sales', attendance: 78 },
                { department: 'Marketing', attendance: 88 },
                { department: 'Finance', attendance: 95 }
            ];

            departmentChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: deptData.map(d => d.department),
                    datasets: [{
                        label: 'Attendance Rate %',
                        data: deptData.map(d => d.attendance),
                        backgroundColor: [
                            '#3498db', '#9b59b6', '#e74c3c', '#f39c12', '#27ae60'
                        ],
                        borderColor: [
                            '#2980b9', '#8e44ad', '#c0392b', '#e67e22', '#229954'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Department-wise Performance',
                            font: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                callback: function(value) {
                                    return value + '%';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Peak Hours Chart
        function initializePeakHoursChart() {
            const ctx = document.getElementById('peakHoursChart');
            if (!ctx) return;

            const hours = ['6-8 AM', '8-10 AM', '10-12 PM', '12-2 PM', '2-4 PM', '4-6 PM', '6-8 PM'];
            const checkIns = [5, 45, 35, 8, 12, 25, 10];
            const checkOuts = [2, 8, 12, 38, 42, 35, 15];

            peakHoursChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: hours,
                    datasets: [{
                        label: 'Check-ins',
                        data: checkIns,
                        backgroundColor: '#e74c3c',
                        borderColor: '#c0392b',
                        borderWidth: 1
                    }, {
                        label: 'Check-outs',
                        data: checkOuts,
                        backgroundColor: '#3498db',
                        borderColor: '#2980b9',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Employee Check-in/out Patterns',
                            font: { size: 14, weight: 'bold' }
                        }
                    }
                }
            });
        }

        // Overtime Chart
        function initializeOvertimeChart() {
            const ctx = document.getElementById('overtimeChart');
            if (!ctx) return;

            overtimeChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Regular Hours', 'Overtime (<2 hrs)', 'Overtime (2-4 hrs)', 'Excessive OT (>4 hrs)'],
                    datasets: [{
                        data: [65, 20, 10, 5],
                        backgroundColor: [
                            '#27ae60',
                            '#f39c12', 
                            '#e67e22',
                            '#e74c3c'
                        ],
                        borderWidth: 2,
                        borderColor: 'white'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Overtime Distribution',
                            font: { size: 14, weight: 'bold' }
                        },
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });
        }

        // Day of Week Chart
        function initializeDayOfWeekChart() {
            const ctx = document.getElementById('dayOfWeekChart');
            if (!ctx) return;

            const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
            const attendance = [88, 92, 90, 89, 85, 45, 30];

            dayOfWeekChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: days,
                    datasets: [{
                        label: 'Attendance %',
                        data: attendance,
                        backgroundColor: '#9b59b6',
                        borderColor: '#8e44ad',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Attendance by Day of Week',
                            font: { size: 14, weight: 'bold' }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: {
                                callback: function(value) {
                                    return value + '%';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Late Patterns Chart
        function initializeLatePatternsChart() {
            const ctx = document.getElementById('latePatternsChart');
            if (!ctx) return;

            const lateData = [15, 8, 12, 6, 10, 20, 5]; // Late arrivals by day

            latePatternsChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                    datasets: [{
                        label: 'Late Arrivals',
                        data: lateData,
                        borderColor: '#e74c3c',
                        backgroundColor: 'rgba(231, 76, 60, 0.1)',
                        tension: 0.4,
                        fill: true,
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        title: {
                            display: true,
                            text: 'Late Arrival Trends',
                            font: { size: 14, weight: 'bold' }
                        }
                    }
                }
            });
        }

        // Filter Functions
        function setTimeFilter(filter) {
            currentFilter = filter;
            
            // Update active button
            document.querySelectorAll('.filter-tab').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Show loading
            showChartLoading();
            
            // Simulate API call
            setTimeout(() => {
                refreshCharts();
                showNotification(`Analytics updated for ${filter} view`, 'success');
            }, 1000);
        }

        function updateTrendChart() {
            const metric = document.getElementById('trendMetric').value;
            showNotification(`Trend chart updated to show ${metric}`, 'success');
        }

        function refreshCharts() {
            // Destroy existing charts
            if (trendChart) trendChart.destroy();
            if (departmentChart) departmentChart.destroy();
            if (peakHoursChart) peakHoursChart.destroy();
            if (overtimeChart) overtimeChart.destroy();
            if (dayOfWeekChart) dayOfWeekChart.destroy();
            if (latePatternsChart) latePatternsChart.destroy();
            
            // Reinitialize charts
            initializeAnalyticsCharts();
        }

        function showChartLoading() {
            const containers = document.querySelectorAll('.chart-container');
            containers.forEach(container => {
                container.innerHTML = '<div class="chart-loading"><div class="spinner"></div><p>Loading chart data...</p></div>';
            });
        }

        // Export and Refresh Functions
        function exportAnalyticsReport() {
            showNotification('Analytics report exported successfully!', 'success');
            // In real implementation, this would download a file
        }

        function refreshAnalytics() {
            showChartLoading();
            setTimeout(() => {
                refreshCharts();
                showNotification('Analytics data refreshed!', 'success');
            }, 1500);
        }

        // Notification system
        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification notification-${type}`;
            notification.innerHTML = `
                <div class="notification-content">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                    <span>${message}</span>
                </div>
            `;

            document.body.appendChild(notification);

            setTimeout(() => {
                notification.remove();
            }, 4000);
        }

        // Initialize when page loads
        document.addEventListener('DOMContentLoaded', function() {
            initializeAnalyticsCharts();
            
            // Add animations to insight cards
            const insightCards = document.querySelectorAll('.insight-card');
            insightCards.forEach((card, index) => {
                card.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
</body>
</html>
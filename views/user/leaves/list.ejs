<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">My Leave History</h1>
            <p class="text-muted mb-0">Track and manage your leave applications</p>
        </div>
        <a href="/user/leaves/apply" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle me-2"></i>Apply for Leave
        </a>
    </div>

    <!-- Success Message -->
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    <% } %>

    <!-- Leaves Summary Cards -->
    <% if (leaves && leaves.length > 0) { %>
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">Total Leaves</h6>
                            <h3 class="fw-bold mb-0"><%= leaves.length %></h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-calendar-alt fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">Approved</h6>
                            <h3 class="fw-bold mb-0">
                                <%= leaves.filter(l => l.status === 'approved').length %>
                            </h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-check-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-warning text-dark h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-dark-50">Pending</h6>
                            <h3 class="fw-bold mb-0">
                                <%= leaves.filter(l => l.status === 'pending').length %>
                            </h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-clock fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-danger text-white h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h6 class="card-title text-white-50">Rejected</h6>
                            <h3 class="fw-bold mb-0">
                                <%= leaves.filter(l => l.status === 'rejected').length %>
                            </h3>
                        </div>
                        <div class="align-self-center">
                            <i class="fas fa-times-circle fa-2x opacity-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- Leaves Table -->
    <% if (leaves && leaves.length > 0) { %>
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="card-title mb-0 fw-semibold">
                    <i class="fas fa-list-alt text-primary me-2"></i>Leave Applications
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Leave Type</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Duration</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Applied On</th>
                                <th class="pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% leaves.forEach(function(leave) { %>
                                <tr class="leave-row">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <% if (leave.leaveType === 'full-day') { %>
                                                <i class="fas fa-sun text-warning me-2"></i>
                                            <% } else { %>
                                                <i class="fas fa-clock text-info me-2"></i>
                                            <% } %>
                                            <span class="text-capitalize"><%= leave.leaveType.replace('-', ' ') %></span>
                                        </div>
                                    </td>
                                    <td>
                                        <strong><%= new Date(leave.startDate).toLocaleDateString('en-IN') %></strong>
                                    </td>
                                    <td>
                                        <% if (leave.leaveType === 'full-day') { %>
                                            <strong><%= new Date(leave.endDate).toLocaleDateString('en-IN') %></strong>
                                        <% } else { %>
                                            <span class="text-muted">N/A</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <%= leave.days %> day<%= leave.days > 1 ? 's' : '' %>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="d-inline-block text-truncate" style="max-width: 200px;" 
                                              title="<%= leave.reason %>">
                                            <%= leave.reason %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (leave.status === 'pending') { %>
                                            <span class="badge bg-warning text-dark px-3 py-2">
                                                <i class="fas fa-clock me-1"></i>Pending
                                            </span>
                                        <% } else if (leave.status === 'approved') { %>
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="fas fa-check me-1"></i>Approved
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="fas fa-times me-1"></i>Rejected
                                            </span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <%= new Date(leave.createdAt).toLocaleDateString('en-IN') %>
                                        </small>
                                    </td>
                                    <td class="pe-4">
                                        <button class="btn btn-sm btn-outline-primary view-reason" 
                                                data-reason="<%= leave.reason %>"
                                                data-type="<%= leave.leaveType %>"
                                                data-status="<%= leave.status %>">
                                            <i class="fas fa-eye me-1"></i>View
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="text-center py-5">
            <div class="empty-state-icon mb-4">
                <i class="fas fa-calendar-times fa-4x text-muted"></i>
            </div>
            <h4 class="text-dark mb-3">No Leave Applications</h4>
            <p class="text-muted mb-4">You haven't applied for any leaves yet. Start by applying for your first leave.</p>
            <a href="/user/leaves/apply" class="btn btn-primary btn-lg">
                <i class="fas fa-plus-circle me-2"></i>Apply for Your First Leave
            </a>
        </div>
    <% } %>
</div>

<!-- Reason Modal -->
<div class="modal fade" id="reasonModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-file-alt text-primary me-2"></i>Leave Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <strong>Leave Type:</strong>
                    <span id="modalLeaveType" class="badge bg-primary ms-2"></span>
                </div>
                <div class="mb-3">
                    <strong>Status:</strong>
                    <span id="modalStatus" class="badge ms-2"></span>
                </div>
                <div>
                    <strong>Reason:</strong>
                    <p id="modalReason" class="mt-2 p-3 bg-light rounded"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
.leave-row:hover {
    background-color: #f8f9fa;
    transform: translateY(-1px);
    transition: all 0.2s ease;
}

.card {
    border: none;
    box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
}

.table th {
    border-top: none;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
    color: #6c757d;
}

.empty-state-icon {
    opacity: 0.5;
}

.badge {
    font-weight: 500;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // View Reason Modal
    const viewButtons = document.querySelectorAll('.view-reason');
    const reasonModal = new bootstrap.Modal(document.getElementById('reasonModal'));
    
    viewButtons.forEach(button => {
        button.addEventListener('click', function() {
            const reason = this.getAttribute('data-reason');
            const type = this.getAttribute('data-type');
            const status = this.getAttribute('data-status');
            
            document.getElementById('modalReason').textContent = reason;
            document.getElementById('modalLeaveType').textContent = type.replace('-', ' ');
            document.getElementById('modalLeaveType').className = `badge bg-primary ms-2 text-capitalize`;
            
            const statusBadge = document.getElementById('modalStatus');
            statusBadge.textContent = status;
            statusBadge.className = `badge ms-2 ${
                status === 'approved' ? 'bg-success' : 
                status === 'pending' ? 'bg-warning text-dark' : 'bg-danger'
            } text-capitalize`;
            
            reasonModal.show();
        });
    });
});
</script>
<%# views/user/profile/view.ejs - CLEAN VERSION (NO JS/CSS) %>
<% layout = 'layouts/user-base' %>

<!-- Include CSS from users folder -->
<link rel="stylesheet" href="/users/css/profile.css">

<div class="profile-container container py-4 py-lg-5">
  <div class="row g-4">

    <!-- Left Sidebar - User Card -->
    <div class="col-lg-4">
      <div class="card user-card sticky-top" style="top: 20px;">
        <div class="card-body text-center">
          <!-- Profile Picture - CLEAN VERSION -->
          <div class="avatar-wrapper">
            <img 
              src="<%= user.profilePhoto %>" 
              alt="<%= user.name %>" 
              class="avatar-img"
              id="profileImage"
            >
            <span class="status-dot <%= user.status === 'Active' ? 'bg-success' : 'bg-warning' %>" 
                  title="<%= user.status || 'Active' %>"></span>
          </div>

          <h4 class="card-title mt-3 mb-1"><%= user.name %></h4>
          <p class="text-muted mb-2"><%= user.designation %></p>
          <p class="text-muted small mb-3">
            <i class="fas fa-building me-1"></i>
            <% if (user.department && user.department.name) { %>
              <%= user.department.name %>
            <% } else { %>
              No Department
            <% } %>
          </p>

          <!-- Action Buttons -->
          <div class="d-flex justify-content-center align-items-center gap-2 mt-3">
            <a href="/user/profile/edit" class="btn btn-primary btn-sm px-3">
              <i class="fas fa-edit me-1"></i> Edit Profile
            </a>
            <button class="btn btn-outline-secondary btn-sm px-3" id="shareProfileBtn">
              <i class="fas fa-share-alt me-1"></i> Share
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm icon-btn" id="themeToggle" title="Toggle Theme">
              <i class="fas fa-moon"></i>
            </button>
          </div>

          <!-- Profile Completion -->
          <% if (user.profileCompletion !== undefined) { %>
          <div class="mt-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <small class="text-muted">Profile Completion</small>
              <small class="text-muted"><%= user.profileCompletion %>%</small>
            </div>
            <div class="progress" style="height: 6px;">
              <div class="progress-bar" role="progressbar" 
                   style="width: <%= user.profileCompletion %>%;" 
                   aria-valuenow="<%= user.profileCompletion %>" 
                   aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          </div>
          <% } %>
        </div>

        <!-- Contact Information -->
        <div class="card-footer">
          <div class="info-list">
            <div class="info-item">
              <i class="fas fa-envelope info-icon"></i>
              <div>
                <small class="text-muted">Work Email</small>
                <span><%= user.email %></span>
              </div>
              <button class="btn btn-sm btn-outline-secondary copy-btn ms-auto" data-copy="<%= user.email %>">
                <i class="far fa-copy"></i>
              </button>
            </div>

            <% if (user.phone) { %>
            <div class="info-item">
              <i class="fas fa-phone info-icon"></i>
              <div>
                <small class="text-muted">Work Phone</small>
                <span><%= user.phone %></span>
              </div>
              <button class="btn btn-sm btn-outline-secondary copy-btn ms-auto" data-copy="<%= user.phone %>">
                <i class="far fa-copy"></i>
              </button>
            </div>
            <% } %>

            <% if (user.personalEmail) { %>
            <div class="info-item">
              <i class="fas fa-envelope-open info-icon"></i>
              <div>
                <small class="text-muted">Personal Email</small>
                <span><%= user.personalEmail %></span>
              </div>
              <button class="btn btn-sm btn-outline-secondary copy-btn ms-auto" data-copy="<%= user.personalEmail %>">
                <i class="far fa-copy"></i>
              </button>
            </div>
            <% } %>

            <% if (user.emergencyContactName) { %>
            <div class="info-item">
              <i class="fas fa-phone-alt info-icon"></i>
              <div>
                <small class="text-muted">Emergency Contact</small>
                <span><%= user.emergencyContactName %></span>
                <% if (user.emergencyContactNumber) { %>
                <small class="text-muted d-block"><%= user.emergencyContactNumber %></small>
                <% } %>
              </div>
            </div>
            <% } %>

            <div class="info-item">
              <i class="fas fa-id-card info-icon"></i>
              <div>
                <small class="text-muted">Employee ID</small>
                <span><%= user.employeeId %></span>
              </div>
              <% if (user.employeeId && user.employeeId !== 'Not assigned') { %>
              <button class="btn btn-sm btn-outline-secondary copy-btn ms-auto" data-copy="<%= user.employeeId %>">
                <i class="far fa-copy"></i>
              </button>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-8">
      <!-- Quick Stats -->
      <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
          <div class="card summary-card">
            <div class="card-body">
              <h5 class="value"><%= user.leavesRemaining %></h5>
              <p class="label">Leaves Left</p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="card summary-card">
            <div class="card-body">
              <h5 class="value"><%= user.attendancePercentage %>%</h5>
              <p class="label">Attendance</p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="card summary-card">
            <div class="card-body">
              <h5 class="value"><%= user.totalExperience %></h5>
              <p class="label">Experience</p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="card summary-card">
            <div class="card-body">
              <h5 class="value">
                <% if (user.performanceRating && user.performanceRating > 0) { %>
                  <%= user.performanceRating %>/5
                <% } else { %>
                  N/A
                <% } %>
              </h5>
              <p class="label">Performance</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Detailed Information Tabs -->
      <div class="card">
        <div class="card-header">
          <ul class="nav nav-tabs card-header-tabs" id="profileTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#professional" type="button">
                <i class="fas fa-briefcase me-1"></i> Professional
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#personal" type="button">
                <i class="fas fa-user me-1"></i> Personal
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#education" type="button">
                <i class="fas fa-graduation-cap me-1"></i> Education
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" data-bs-toggle="tab" data-bs-target="#account" type="button">
                <i class="fas fa-file-invoice me-1"></i> Account & IDs
              </button>
            </li>
          </ul>
        </div>

        <div class="card-body tab-content p-4" id="profileTabsContent">
          <!-- Professional Tab -->
          <div class="tab-pane fade show active" id="professional" role="tabpanel">
            <h5 class="mb-4"><i class="fas fa-briefcase me-2"></i>Professional Information</h5>
            <div class="row g-4">
              <div class="col-md-6">
                <small class="text-muted">Employee ID</small>
                <p><%= user.employeeId %></p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Date of Joining</small>
                <p>
                  <% if (user.joiningDate) { %>
                    <%= new Date(user.joiningDate).toLocaleDateString() %>
                  <% } else { %>
                    —
                  <% } %>
                </p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Designation</small>
                <p><%= user.designation %></p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Department</small>
                <p>
                  <% if (user.department && user.department.name) { %>
                    <%= user.department.name %>
                  <% } else { %>
                    No Department
                  <% } %>
                </p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Reporting Manager</small>
                <p>
                  <% if (user.reportingManager && user.reportingManager.name) { %>
                    <%= user.reportingManager.name %>
                  <% } else { %>
                    N/A
                  <% } %>
                </p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Employee Type</small>
                <p><%= user.employeeType %></p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Work Location</small>
                <p><%= user.workLocation %></p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Employee Status</small>
                <p><%= user.employeeStatus %></p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Shift Timings</small>
                <p><%= user.shiftTimings %></p>
              </div>
              <div class="col-md-6">
                <small class="text-muted">Team</small>
                <p><%= user.team %></p>
              </div>
            </div>

            <!-- Skills Section -->
            <% if (user.skills && user.skills.length > 0) { %>
            <div class="mt-5">
              <h6 class="mb-3">Skills</h6>
              <div class="d-flex flex-wrap gap-2">
                <% user.skills.forEach(skill => { %>
                  <span class="badge bg-primary py-2 px-3"><%= skill %></span>
                <% }) %>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Personal Tab -->
          <div class="tab-pane fade" id="personal" role="tabpanel">
            <h5 class="mb-4"><i class="fas fa-user me-2"></i>Personal Details</h5>
            <div class="row g-4">
              <% if (user.dob) { %>
              <div class="col-md-6">
                <small class="text-muted">Date of Birth</small>
                <p>
                  <%= new Date(user.dob).toLocaleDateString() %>
                  <% if (user.age) { %> (<%= user.age %> years)<% } %>
                </p>
              </div>
              <% } %>
              
              <% if (user.gender) { %>
              <div class="col-md-6">
                <small class="text-muted">Gender</small>
                <p><%= user.gender %></p>
              </div>
              <% } %>

              <% if (user.bloodGroup) { %>
              <div class="col-md-6">
                <small class="text-muted">Blood Group</small>
                <p><%= user.bloodGroup %></p>
              </div>
              <% } %>

              <% if (user.personalEmail) { %>
              <div class="col-md-6">
                <small class="text-muted">Personal Email</small>
                <p><%= user.personalEmail %></p>
              </div>
              <% } %>

              <% if (user.currentAddress) { %>
              <div class="col-12">
                <small class="text-muted">Current Address</small>
                <p><%= user.currentAddress %></p>
              </div>
              <% } %>

              <% if (user.permanentAddress) { %>
              <div class="col-12">
                <small class="text-muted">Permanent Address</small>
                <p><%= user.permanentAddress %></p>
              </div>
              <% } %>
            </div>
          </div>

          <!-- Education Tab -->
          <div class="tab-pane fade" id="education" role="tabpanel">
            <h5 class="mb-4"><i class="fas fa-graduation-cap me-2"></i>Education Details</h5>
            
            <% if (user.qualification || user.university) { %>
            <div class="row g-4">
              <% if (user.qualification) { %>
              <div class="col-md-6">
                <small class="text-muted">Highest Qualification</small>
                <p><%= user.qualification %></p>
              </div>
              <% } %>

              <% if (user.university) { %>
              <div class="col-md-6">
                <small class="text-muted">University</small>
                <p><%= user.university %></p>
              </div>
              <% } %>

              <% if (user.yearOfPassing) { %>
              <div class="col-md-6">
                <small class="text-muted">Year of Passing</small>
                <p><%= user.yearOfPassing %></p>
              </div>
              <% } %>

              <% if (user.percentage) { %>
              <div class="col-md-6">
                <small class="text-muted">Percentage/CGPA</small>
                <p><%= user.percentage %></p>
              </div>
              <% } %>
            </div>
            <% } else { %>
            <div class="text-center py-4">
              <i class="fas fa-graduation-cap fa-2x text-muted mb-3"></i>
              <p class="text-muted">No education details added</p>
              <a href="/user/profile/edit" class="btn btn-primary btn-sm">Add Education</a>
            </div>
            <% } %>

            <!-- Experience Section -->
            <% if (user.previousCompany || user.experienceYears > 0) { %>
            <div class="mt-5">
              <h6 class="mb-3">Work Experience</h6>
              <div class="row g-4">
                <% if (user.previousCompany) { %>
                <div class="col-md-6">
                  <small class="text-muted">Previous Company</small>
                  <p><%= user.previousCompany %></p>
                </div>
                <% } %>

                <% if (user.previousDesignation) { %>
                <div class="col-md-6">
                  <small class="text-muted">Previous Designation</small>
                  <p><%= user.previousDesignation %></p>
                </div>
                <% } %>

                <% if (user.experienceYears > 0) { %>
                <div class="col-md-6">
                  <small class="text-muted">Total Experience</small>
                  <p><%= user.experienceYears %> years</p>
                </div>
                <% } %>
              </div>
            </div>
            <% } %>
          </div>

          <!-- Account & IDs Tab -->
          <div class="tab-pane fade" id="account" role="tabpanel">
            <h5 class="mb-4"><i class="fas fa-file-invoice me-2"></i>Account & Government IDs</h5>
            
            <!-- Bank Details -->
            <% if (user.bankName || user.accountNumber) { %>
            <div class="mb-5">
              <h6 class="mb-3">Bank Account Details</h6>
              <div class="row g-3">
                <% if (user.accountNumber) { %>
                <div class="col-md-6 info-with-copy">
                  <div>
                    <small class="text-muted">Account Number</small>
                    <p><%= user.accountNumber %></p>
                  </div>
                  <button class="btn btn-sm btn-outline-secondary copy-btn" data-copy="<%= user.accountNumber %>">
                    <i class="far fa-copy"></i>
                  </button>
                </div>
                <% } %>

                <% if (user.ifscCode) { %>
                <div class="col-md-6 info-with-copy">
                  <div>
                    <small class="text-muted">IFSC Code</small>
                    <p><%= user.ifscCode %></p>
                  </div>
                  <button class="btn btn-sm btn-outline-secondary copy-btn" data-copy="<%= user.ifscCode %>">
                    <i class="far fa-copy"></i>
                  </button>
                </div>
                <% } %>

                <% if (user.bankName) { %>
                <div class="col-md-6">
                  <small class="text-muted">Bank Name</small>
                  <p><%= user.bankName %></p>
                </div>
                <% } %>

                <% if (user.accountType) { %>
                <div class="col-md-6">
                  <small class="text-muted">Account Type</small>
                  <p><%= user.accountType %></p>
                </div>
                <% } %>

                <% if (user.branchName) { %>
                <div class="col-md-6">
                  <small class="text-muted">Branch Name</small>
                  <p><%= user.branchName %></p>
                </div>
                <% } %>
              </div>
            </div>
            <% } %>

            <!-- Government IDs -->
            <div class="row g-4">
              <% if (user.panNumber) { %>
              <div class="col-md-6 info-with-copy">
                <div>
                  <small class="text-muted">PAN Number</small>
                  <p><%= user.panNumber %></p>
                </div>
                <button class="btn btn-sm btn-outline-secondary copy-btn" data-copy="<%= user.panNumber %>">
                  <i class="far fa-copy"></i>
                </button>
              </div>
              <% } %>

              <% if (user.aadharNumber) { %>
              <div class="col-md-6 info-with-copy">
                <div>
                  <small class="text-muted">Aadhar Number</small>
                  <p><%= user.aadharNumber %></p>
                </div>
                <button class="btn btn-sm btn-outline-secondary copy-btn" data-copy="<%= user.aadharNumber %>">
                  <i class="far fa-copy"></i>
                </button>
              </div>
              <% } %>

              <% if (user.passportNumber) { %>
              <div class="col-md-6 info-with-copy">
                <div>
                  <small class="text-muted">Passport Number</small>
                  <p><%= user.passportNumber %></p>
                </div>
                <button class="btn btn-sm btn-outline-secondary copy-btn" data-copy="<%= user.passportNumber %>">
                  <i class="far fa-copy"></i>
                </button>
              </div>
              <% } %>

              <% if (user.drivingLicense) { %>
              <div class="col-md-6 info-with-copy">
                <div>
                  <small class="text-muted">Driving License</small>
                  <p><%= user.drivingLicense %></p>
                </div>
                <button class="btn btn-sm btn-outline-secondary copy-btn" data-copy="<%= user.drivingLicense %>">
                  <i class="far fa-copy"></i>
                </button>
              </div>
              <% } %>

              <% if (user.uanNumber) { %>
              <div class="col-md-6">
                <small class="text-muted">UAN Number</small>
                <p><%= user.uanNumber %></p>
              </div>
              <% } %>

              <% if (user.pfNumber) { %>
              <div class="col-md-6">
                <small class="text-muted">PF Number</small>
                <p><%= user.pfNumber %></p>
              </div>
              <% } %>

              <% if (user.esicNumber) { %>
              <div class="col-md-6">
                <small class="text-muted">ESIC Number</small>
                <p><%= user.esicNumber %></p>
              </div>
              <% } %>
            </div>

            <% if (!user.bankName && !user.panNumber && !user.aadharNumber) { %>
            <div class="text-center py-4">
              <i class="fas fa-file-invoice fa-2x text-muted mb-3"></i>
              <p class="text-muted">No account details added</p>
              <a href="/user/profile/edit" class="btn btn-primary btn-sm">Add Account Details</a>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Include JavaScript from users folder -->
<script src="/users/js/profile.js"></script>
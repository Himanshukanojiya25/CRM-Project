                    <i class="fas fa-bug"></i>
                    <span>Bug Report</span>
                    <small>Something's not working</small>
                  </label>
                </div>
                <div class="category-option">
                  <input type="radio" name="category" value="feature" id="cat-feature" class="category-input">
                  <label for="cat-feature" class="category-label">
                    <i class="fas fa-lightbulb"></i>
                    <span>Feature Request</span>
                    <small>Suggest new features</small>
                  </label>
                </div>
                <div class="category-option">
                  <input type="radio" name="category" value="complaint" id="cat-complaint" class="category-input">
                  <label for="cat-complaint" class="category-label">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Complaint</span>
                    <small>Report an issue</small>
                  </label>
                </div>
                <div class="category-option">
                  <input type="radio" name="category" value="appreciation" id="cat-appreciation" class="category-input">
                  <label for="cat-appreciation" class="category-label">
                    <i class="fas fa-heart"></i>
                    <span>Appreciation</span>
                    <small>Share positive feedback</small>
                  </label>
                </div>
                <div class="category-option">
                  <input type="radio" name="category" value="suggestion" id="cat-suggestion" class="category-input">
                  <label for="cat-suggestion" class="category-label">
                    <i class="fas fa-hand-point-up"></i>
                    <span>Suggestion</span>
                    <small>Ideas for improvement</small>
                  </label>
                </div>
              </div>
            </div>

            <!-- Priority & Rating -->
            <div class="row g-4 mb-4">
              <div class="col-md-6">
                <label class="form-label fw-semibold">
                  <i class="fas fa-flag me-2"></i>Priority Level

<%# views/user/feedback/submit.ejs - SUPER ATTRACTIVE FEEDBACK FORM %>
<% layout = 'layouts/user-base' %>

<!-- Include CSS -->
<link rel="stylesheet" href="/users/css/feedback.css">

<div class="feedback-container">
  <!-- Header Section - ENHANCED: Added Drafts Button -->
  <div class="feedback-header">
    <div class="header-content">
      <div class="header-icon">
        <i class="fas fa-comment-dots"></i>
      </div>
      <div class="header-text">
        <h1 class="display-5 fw-bold text-gradient">Share Your Feedback</h1>
        <p class="lead text-muted">We value your opinion! Help us improve with your suggestions, bug reports, or feature requests.</p>
      </div>
      <div class="header-actions">
        <!-- Drafts Button -->
        <button type="button" class="btn btn-warning btn-lg me-2" id="viewDraftsBtn">
          <i class="fas fa-save me-2"></i>View Drafts (<span id="draftsCount">0</span>)
        </button>
        <!-- History Button -->
        <a href="/user/feedback/history" class="btn btn-outline-light btn-lg me-2">
          <i class="fas fa-history me-2"></i>View History
        </a>
        <a href="/user/feedback" class="btn btn-primary btn-lg">
          <i class="fas fa-plus me-2"></i>New Feedback
        </a>
      </div>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
      <!-- Quick Stats Bar -->
      <div class="quick-stats-bar mb-4">
        <div class="row g-3">
          <div class="col-md-4">
            <div class="stat-item">
              <i class="fas fa-clock text-warning"></i>
              <div>
                <span class="stat-number">24h</span>
                <span class="stat-label">Avg Response</span>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-item">
              <i class="fas fa-check-circle text-success"></i>
              <div>
                <span class="stat-number">95%</span>
                <span class="stat-label">Resolved</span>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-item">
              <i class="fas fa-comments text-info"></i>
              <div>
                <span class="stat-number">100+</span>
                <span class="stat-label">Feedbacks</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Auto-Save Indicator -->
      <div class="auto-save-indicator alert alert-info d-none" id="autoSaveIndicator">
        <i class="fas fa-save me-2"></i>
        <span id="autoSaveText">Auto-saving...</span>
        <span class="float-end" id="lastSaved"></span>
      </div>

      <!-- Template Quick Insert -->
      <div class="template-section mb-4">
        <h4 class="section-title">
          <i class="fas fa-magic me-2"></i>Quick Templates
        </h4>
        <div class="template-buttons">
          <button type="button" class="btn btn-outline-primary btn-sm template-btn" data-template="bug">
            <i class="fas fa-bug me-1"></i>Bug Report
          </button>
          <button type="button" class="btn btn-outline-success btn-sm template-btn" data-template="feature">
            <i class="fas fa-lightbulb me-1"></i>Feature Request
          </button>
          <button type="button" class="btn btn-outline-warning btn-sm template-btn" data-template="complaint">
            <i class="fas fa-exclamation-triangle me-1"></i>Complaint
          </button>
          <button type="button" class="btn btn-outline-info btn-sm template-btn" data-template="suggestion">
            <i class="fas fa-hand-point-up me-1"></i>Suggestion
          </button>
        </div>
      </div>

      <!-- Feedback Form -->
      <div class="card feedback-form-card shadow-lg border-0">
        <div class="card-body p-5">
          <form id="feedbackForm" action="/user/feedback" method="POST" enctype="multipart/form-data" novalidate>
            

                  <option value="medium" selected>🟡 Medium - Standard priority</option>
                  <option value="high">🟠 High - Important issue</option>
                  <option value="urgent">🔴 Urgent - Critical problem</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold">
                  <i class="fas fa-star me-2"></i>Overall Rating (Optional)
                </label>
                <div class="rating-stars">
                  <input type="radio" name="rating" value="5" id="star5">
                  <label for="star5">★</label>
                  <input type="radio" name="rating" value="4" id="star4">
                  <label for="star4">★</label>
                  <input type="radio" name="rating" value="3" id="star3">
                  <label for="star3">★</label>
                  <input type="radio" name="rating" value="2" id="star2">
                  <label for="star2">★</label>
                  <input type="radio" name="rating" value="1" id="star1">
                  <label for="star1">★</label>
                </div>
              </div>
            </div>

            <!-- Title & Message -->
            <div class="form-section mb-4">
              <h4 class="section-title">
                <i class="fas fa-edit me-2"></i>Feedback Details
              </h4>
              
              <div class="mb-4">
                <label for="title" class="form-label fw-semibold">
                  <i class="fas fa-heading me-2"></i>Brief Title *
                </label>
                <input type="text" 
                       class="form-control form-control-lg" 
                       id="title" 
                       name="title" 
                       placeholder="e.g., Login page loading slowly"
                       required
                       maxlength="200">
                <div class="form-text">Summarize your feedback in one line</div>
              </div>

              <div class="mb-4">
                <label for="message" class="form-label fw-semibold">
                  <i class="fas fa-align-left me-2"></i>Detailed Description *
                </label>
                <textarea class="form-control" 
                          id="message" 
                          name="message" 
                          rows="6" 
                          placeholder="Please provide detailed information about your feedback, issue, or suggestion..."
                          required
                          maxlength="2000"></textarea>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <div class="form-text">Be as detailed as possible</div>
                  <div class="character-count">
                    <span id="charCount">0</span>/2000 characters
                  </div>
                </div>
              </div>
            </div>

            <!-- Page URL -->
            <div class="mb-4">
              <label for="pageUrl" class="form-label fw-semibold">
                <i class="fas fa-link me-2"></i>Page URL (Optional)
              </label>
              <input type="url" 
                     class="form-control" 
                     id="pageUrl" 
                     name="pageUrl" 
                     placeholder="https://example.com/page">
              <div class="form-text">Which page were you on when you encountered this?</div>
            </div>

            <!-- File Uploads -->
            <div class="form-section mb-4">
              <h4 class="section-title">
                <i class="fas fa-paperclip me-2"></i>Attachments
              </h4>
              
              <!-- Screenshots -->
              <div class="mb-4">
                <label class="form-label fw-semibold">
                  <i class="fas fa-camera me-2"></i>Screenshots (Max 2 files)
                </label>
                <div class="file-upload-area" id="screenshotUpload" onclick="document.getElementById('screenshots').click()">
                  <i class="fas fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                  <h5>Click here to upload screenshots</h5>
                  <p class="text-muted">PNG, JPG, GIF up to 10MB each</p>
                  <input type="file" 
                         name="screenshots" 
                         id="screenshots" 
                         multiple 
                         accept="image/*"
                         class="file-input"
                         onchange="handleFileSelect(this, 'screenshotPreview')">
                  <div class="file-preview mt-3" id="screenshotPreview"></div>
                </div>
              </div>

              <!-- Attachments -->
              <div class="mb-4">
                <label class="form-label fw-semibold">
                  <i class="fas fa-file me-2"></i>Additional Files (Max 3 files)
                </label>
                <div class="file-upload-area" id="attachmentUpload" onclick="document.getElementById('attachments').click()">
                  <i class="fas fa-file-upload fa-3x text-muted mb-3"></i>
                  <h5>Click here to upload files</h5>
                  <p class="text-muted">PDF, DOC, TXT, ZIP up to 10MB each</p>
                  <input type="file" 
                         name="attachments" 
                         id="attachments" 
                         multiple 
                         accept=".pdf,.doc,.docx,.txt,.zip,.rar,image/*"
                         class="file-input"
                         onchange="handleFileSelect(this, 'attachmentPreview')">
                  <div class="file-preview mt-3" id="attachmentPreview"></div>
                </div>
              </div>
            </div>

            <!-- Privacy Options -->
            <div class="form-section mb-4">
              <h4 class="section-title">
                <i class="fas fa-shield-alt me-2"></i>Privacy Settings
              </h4>
              <div class="row g-3">
                <div class="col-md-6">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="isAnonymous" id="isAnonymous">
                    <label class="form-check-label" for="isAnonymous">
                      <i class="fas fa-user-secret me-2"></i>Submit Anonymously
                    </label>
                  </div>
                  <div class="form-text">Your name will not be visible to admins</div>
                </div>
                <div class="col-md-6">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="isPublic" id="isPublic">
                    <label class="form-check-label" for="isPublic">
                      <i class="fas fa-globe me-2"></i>Make Public
                    </label>
                  </div>
                  <div class="form-text">Other users can see this feedback</div>
                </div>
              </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions mt-5 pt-4 border-top">
              <div class="row g-3">
                <div class="col-md-4">
                  <button type="button" class="btn btn-outline-secondary btn-lg w-100" id="saveDraftBtn">
                    <i class="fas fa-save me-2"></i>Save Draft
                  </button>
                </div>
                <div class="col-md-4">
                  <button type="button" class="btn btn-outline-info btn-lg w-100" id="previewBtn">
                    <i class="fas fa-eye me-2"></i>Preview
                  </button>
                </div>
                <div class="col-md-4">
                  <button type="submit" class="btn btn-primary btn-lg w-100 submit-btn" id="submitBtn">
                    <i class="fas fa-paper-plane me-2"></i>Submit Feedback
                  </button>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Quick Tips -->
      <div class="card quick-tips-card mt-4 border-0">
        <div class="card-body">
          <h5 class="card-title">
            <i class="fas fa-lightbulb me-2 text-warning"></i>Tips for Great Feedback
          </h5>
          <div class="row g-3">
            <div class="col-md-6">
              <div class="tip-item">
                <i class="fas fa-check-circle text-success"></i>
                <span>Be specific and detailed</span>
              </div>
              <div class="tip-item">
                <i class="fas fa-check-circle text-success"></i>
                <span>Include steps to reproduce bugs</span>
              </div>
              <div class="tip-item">
                <i class="fas fa-check-circle text-success"></i>
                <span>Use templates for common issues</span>
              </div>
            </div>
            <div class="col-md-6">
              <div class="tip-item">
                <i class="fas fa-check-circle text-success"></i>
                <span>Add screenshots for visual issues</span>
              </div>
              <div class="tip-item">
                <i class="fas fa-check-circle text-success"></i>
                <span>Suggest solutions if possible</span>
              </div>
              <div class="tip-item">
                <i class="fas fa-check-circle text-success"></i>
                <span>Save drafts to continue later</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript -->
<script>
// Character counter for message
document.getElementById('message').addEventListener('input', function() {
  const charCount = this.value.length;
  document.getElementById('charCount').textContent = charCount;
});

// File upload handling - ORIGINAL WORKING CODE
function handleFileSelect(input, previewId) {
  const files = input.files;
  const preview = document.getElementById(previewId);
  preview.innerHTML = '';
  
  if (files.length > 0) {
    const fileList = document.createElement('div');
    fileList.className = 'file-list';
    
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      const fileItem = document.createElement('div');
      fileItem.className = 'file-preview-item';
      
      // File icon based on type
      let icon = 'fa-file';
      if (file.type.startsWith('image/')) {
        icon = 'fa-file-image';
      } else if (file.type.includes('pdf')) {
        icon = 'fa-file-pdf';
      } else if (file.type.includes('word') || file.type.includes('document')) {
        icon = 'fa-file-word';
      } else if (file.type.includes('zip') || file.type.includes('rar')) {
        icon = 'fa-file-archive';
      }
      
      fileItem.innerHTML = `
        <i class="fas ${icon} text-primary"></i>
        <div class="file-info">
          <div class="file-name">${file.name}</div>
          <div class="file-size">${formatFileSize(file.size)}</div>
        </div>
        <button type="button" class="btn-remove-file" onclick="removeFile(${i}, '${input.id}', '${previewId}')">
          <i class="fas fa-times"></i>
        </button>
      `;
      
      fileList.appendChild(fileItem);
    }
    
    preview.appendChild(fileList);
    
    // Update upload area text
    const uploadArea = input.parentElement;
    uploadArea.querySelector('h5').textContent = `${files.length} file(s) selected`;
    uploadArea.classList.add('has-files');
  }
}

// Remove file from input
function removeFile(index, inputId, previewId) {
  const input = document.getElementById(inputId);
  const files = Array.from(input.files);
  files.splice(index, 1);
  
  // Create new FileList
  const dt = new DataTransfer();
  files.forEach(file => dt.items.add(file));
  input.files = dt.files;
  
  // Update preview
  handleFileSelect(input, previewId);
}

// Format file size
function formatFileSize(bytes) {
  if (bytes === 0) return '0 Bytes';
  const k = 1024;
  const sizes = ['Bytes', 'KB', 'MB', 'GB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

// Drag and drop functionality
document.querySelectorAll('.file-upload-area').forEach(area => {
  area.addEventListener('dragover', function(e) {
    e.preventDefault();
    this.classList.add('dragover');
  });
  
  area.addEventListener('dragleave', function(e) {
    e.preventDefault();
    this.classList.remove('dragover');
  });
  
  area.addEventListener('drop', function(e) {
    e.preventDefault();
    this.classList.remove('dragover');
    const input = this.querySelector('.file-input');
    input.files = e.dataTransfer.files;
    handleFileSelect(input, this.querySelector('.file-preview').id);
  });
});

// Form validation
document.getElementById('feedbackForm').addEventListener('submit', function(e) {
  const title = document.getElementById('title').value.trim();
  const message = document.getElementById('message').value.trim();
  
  if (!title) {
    e.preventDefault();
    alert('Please enter a feedback title');
    document.getElementById('title').focus();
    return;
  }
  
  if (!message) {
    e.preventDefault();
    alert('Please enter a feedback message');
    document.getElementById('message').focus();
    return;
  }
  
  // Show loading state
  const submitBtn = document.getElementById('submitBtn');
  submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Submitting...';
  submitBtn.disabled = true;
});

// Save draft functionality - WORKING VERSION
document.getElementById('saveDraftBtn').addEventListener('click', function() {
  const draftData = {
    title: document.getElementById('title').value,
    message: document.getElementById('message').value,
    category: document.querySelector('input[name="category"]:checked').value,
    priority: document.getElementById('prioritySelect').value,
    rating: document.querySelector('input[name="rating"]:checked')?.value || null,
    pageUrl: document.getElementById('pageUrl').value,
    isAnonymous: document.getElementById('isAnonymous').checked,
    isPublic: document.getElementById('isPublic').checked,
    savedAt: new Date().toISOString()
  };
  
  // Save to localStorage
  localStorage.setItem('feedbackDraft', JSON.stringify(draftData));
  
  // Show success message
  const originalText = this.innerHTML;
  this.innerHTML = '<i class="fas fa-check me-2"></i>Draft Saved!';
  this.classList.remove('btn-outline-secondary');
  this.classList.add('btn-success');
  
  setTimeout(() => {
    this.innerHTML = originalText;
    this.classList.remove('btn-success');
    this.classList.add('btn-outline-secondary');
  }, 2000);
  
  updateDraftsCount();
  console.log('Draft saved:', draftData);
});

// Load draft on page load
document.addEventListener('DOMContentLoaded', function() {
  const savedDraft = localStorage.getItem('feedbackDraft');
  if (savedDraft) {
    const draft = JSON.parse(savedDraft);
    
    // Populate form fields
    document.getElementById('title').value = draft.title || '';
    document.getElementById('message').value = draft.message || '';
    document.getElementById('pageUrl').value = draft.pageUrl || '';
    
    // Set category
    if (draft.category) {
      document.querySelector(`input[name="category"][value="${draft.category}"]`).checked = true;
    }
    
    // Set priority
    if (draft.priority) {
      document.getElementById('prioritySelect').value = draft.priority;
    }
    
    // Set rating
    if (draft.rating) {
      document.querySelector(`input[name="rating"][value="${draft.rating}"]`).checked = true;
    }
    
    // Set checkboxes
    document.getElementById('isAnonymous').checked = draft.isAnonymous || false;
    document.getElementById('isPublic').checked = draft.isPublic || false;
    
    // Update character count
    document.getElementById('charCount').textContent = draft.message?.length || 0;
    
    console.log('Draft loaded:', draft);
  }

  // Initialize new features
  initTemplates();
  initPreview();
  initDraftsManagement();
  initAutoSave();
  updateDraftsCount();
});

// Clear draft when form is submitted
document.getElementById('feedbackForm').addEventListener('submit', function() {
  localStorage.removeItem('feedbackDraft');
  updateDraftsCount();
});

// NEW FEATURES - SIMPLE AND WORKING

// 1. Quick Templates
function initTemplates() {
  document.querySelectorAll('.template-btn').forEach(button => {
    button.addEventListener('click', function() {
      const templateType = this.dataset.template;
      applyTemplate(templateType);
    });
  });
}

function applyTemplate(templateType) {
  const templates = {
    bug: {
      title: "Bug Report: [Brief Description]",
      message: "🐛 Bug Report\n\nDescription: [Detailed description of the bug]\n\nSteps to Reproduce:\n1. Go to [page/feature]\n2. Click on [element]\n3. Observe the error\n\nExpected Behavior: [What should happen]\nActual Behavior: [What actually happens]\n\nEnvironment:\n- Browser: [Browser and version]\n- Device: [Device type]"
    },
    feature: {
      title: "Feature Request: [Feature Name]", 
      message: "💡 Feature Request\n\nFeature Description: [Detailed description]\n\nProblem it Solves: [What problem will this solve?]\n\nProposed Solution: [How should it work?]\n\nBenefits:\n- [Benefit 1]\n- [Benefit 2]\n- [Benefit 3]"
    },
    complaint: {
      title: "Complaint: [Issue Summary]",
      message: "⚠️ Complaint\n\nIssue: [Clear description]\n\nImpact: [How this affects me]\n\nTimeline: [When did this start?]\n\nExpected Resolution: [What would resolve this?]"
    },
    suggestion: {
      title: "Suggestion: [Improvement Idea]", 
      message: "👆 Suggestion\n\nCurrent Situation: [Describe current process]\n\nSuggested Improvement: [Your suggestion]\n\nReasoning: [Why this would be beneficial]\n\nImplementation Ideas: [How this could be implemented]"
    }
  };

  const template = templates[templateType];
  if (template) {
    document.getElementById('title').value = template.title;
    document.getElementById('message').value = template.message;
    
    // Set appropriate category
    document.querySelector(`input[name="category"][value="${templateType}"]`).checked = true;
    
    // Update character count
    document.getElementById('charCount').textContent = template.message.length;
    
    // Show success message
    showNotification(`${templateType.replace(/_/g, ' ')} template applied!`, 'success');
  }
}

// 2. Preview Functionality
function initPreview() {
  document.getElementById('previewBtn').addEventListener('click', function() {
    const title = document.getElementById('title').value;
    const message = document.getElementById('message').value;
    
    if (!title && !message) {
      showNotification('Please add some content to preview.', 'warning');
      return;
    }

    const previewContent = `
      <h2>${title || 'No Title'}</h2>
      <hr>
      <div style="white-space: pre-line;">${message || 'No content'}</div>
      <hr>
      <p><small>This is a preview of your feedback.</small></p>
    `;
    
    const previewWindow = window.open('', '_blank');
    previewWindow.document.write(`
      <html>
        <head>
          <title>Feedback Preview</title>
          <style>
            body { font-family: Arial, sans-serif; padding: 20px; max-width: 800px; margin: 0 auto; }
            h2 { color: #333; }
            hr { border: 1px solid #eee; }
          </style>
        </head>
        <body>
          <h1>📝 Feedback Preview</h1>
          ${previewContent}
        </body>
      </html>
    `);
    previewWindow.document.close();
  });
}

// 3. Drafts Management
function initDraftsManagement() {
  document.getElementById('viewDraftsBtn').addEventListener('click', function() {
    const savedDraft = localStorage.getItem('feedbackDraft');
    
    if (!savedDraft) {
      showNotification('No drafts saved yet.', 'info');
      return;
    }
    
    const draft = JSON.parse(savedDraft);
    const shouldLoad = confirm(`Load draft: "${draft.title || 'Untitled'}"?\n\nCreated: ${new Date(draft.savedAt).toLocaleString()}\n\nClick OK to load this draft.`);
    
    if (shouldLoad) {
      document.getElementById('title').value = draft.title || '';
      document.getElementById('message').value = draft.message || '';
      document.getElementById('pageUrl').value = draft.pageUrl || '';
      
      if (draft.category) {
        document.querySelector(`input[name="category"][value="${draft.category}"]`).checked = true;
      }
      
      document.getElementById('prioritySelect').value = draft.priority || 'medium';
      document.getElementById('isAnonymous').checked = draft.isAnonymous || false;
      document.getElementById('isPublic').checked = draft.isPublic || false;
      
      document.getElementById('charCount').textContent = draft.message?.length || 0;
      
      showNotification('Draft loaded successfully!', 'success');
    }
  });
}

function updateDraftsCount() {
  const draftsCount = document.getElementById('draftsCount');
  const savedDraft = localStorage.getItem('feedbackDraft');
  
  if (draftsCount) {
    draftsCount.textContent = savedDraft ? '1' : '0';
  }
}

// 4. Auto-Save System
function initAutoSave() {
  let autoSaveTimeout;
  
  // Auto-save on input (with debounce)
  const autoSaveFields = ['title', 'message', 'pageUrl', 'prioritySelect', 'isAnonymous', 'isPublic'];
  
  autoSaveFields.forEach(field => {
    const element = document.getElementById(field);
    if (element) {
      element.addEventListener('input', triggerAutoSave);
      element.addEventListener('change', triggerAutoSave);
    }
  });
  
  // Category and rating changes
  document.querySelectorAll('input[name="category"], input[name="rating"]').forEach(radio => {
    radio.addEventListener('change', triggerAutoSave);
  });
}

function triggerAutoSave() {
  clearTimeout(window.autoSaveTimeout);
  window.autoSaveTimeout = setTimeout(() => {
    const title = document.getElementById('title').value;
    const message = document.getElementById('message').value;
    
    // Only auto-save if there's content
    if (title || message) {
      const draftData = {
        title: title,
        message: message,
        category: document.querySelector('input[name="category"]:checked').value,
        priority: document.getElementById('prioritySelect').value,
        rating: document.querySelector('input[name="rating"]:checked')?.value || null,
        pageUrl: document.getElementById('pageUrl').value,
        isAnonymous: document.getElementById('isAnonymous').checked,
        isPublic: document.getElementById('isPublic').checked,
        savedAt: new Date().toISOString(),
        autoSaved: true
      };
      
      localStorage.setItem('feedbackDraft', JSON.stringify(draftData));
      showAutoSaveIndicator();
      updateDraftsCount();
    }
  }, 2000); // 2 second debounce
}

function showAutoSaveIndicator() {
  const indicator = document.getElementById('autoSaveIndicator');
  const text = document.getElementById('autoSaveText');
  const lastSaved = document.getElementById('lastSaved');
  
  if (indicator) {
    indicator.classList.remove('d-none');
    text.textContent = 'Auto-saved';
    lastSaved.textContent = new Date().toLocaleTimeString();
    
    setTimeout(() => {
      indicator.classList.add('d-none');
    }, 3000);
  }
}

// 5. Notification System
function showNotification(message, type = 'info') {
  // Simple alert for now - you can replace with toast notifications
  const icons = {
    success: '✅',
    error: '❌',
    warning: '⚠️',
    info: 'ℹ️'
  };
  
  alert(`${icons[type] || ''} ${message}`);
}
</script>


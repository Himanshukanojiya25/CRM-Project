<%# views/user/feedback/list.ejs - SUPER ATTRACTIVE FEEDBACK HISTORY %>
<% layout = 'layouts/user-base' %>

<!-- Include CSS -->
<link rel="stylesheet" href="/users/css/feedback.css">

<div class="feedback-history-container">
  <!-- Header Section -->
  <div class="history-header">
    <div class="header-content">
      <div class="header-icon">
        <i class="fas fa-history"></i>
      </div>
      <div class="header-text">
        <h1 class="display-5 fw-bold text-gradient">My Feedback History</h1>
        <p class="lead text-muted">Track all your submitted feedback and their status</p>
      </div>
      <div class="header-actions">
        <a href="/user/feedback" class="btn btn-primary btn-lg">
          <i class="fas fa-plus me-2"></i>New Feedback
        </a>
      </div>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="row g-4 mb-5">
    <div class="col-md-3 col-6">
      <div class="stat-card total">
        <div class="stat-icon">
          <i class="fas fa-comments"></i>
        </div>
        <div class="stat-info">
          <h3 class="stat-number"><%= totalFeedbacks || 0 %></h3>
          <p class="stat-label">Total Feedback</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card pending">
        <div class="stat-icon">
          <i class="fas fa-clock"></i>
        </div>
        <div class="stat-info">
          <h3 class="stat-number"><%= statusStats.pending || 0 %></h3>
          <p class="stat-label">Pending</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card resolved">
        <div class="stat-icon">
          <i class="fas fa-check-circle"></i>
        </div>
        <div class="stat-info">
          <h3 class="stat-number"><%= (statusStats.resolved || 0) + (statusStats.closed || 0) %></h3>
          <p class="stat-label">Resolved</p>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-6">
      <div class="stat-card in-progress">
        <div class="stat-icon">
          <i class="fas fa-cog"></i>
        </div>
        <div class="stat-info">
          <h3 class="stat-number"><%= (statusStats.under_review || 0) + (statusStats.in_progress || 0) %></h3>
          <p class="stat-label">In Progress</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Filters and Search -->
  <div class="card filter-card mb-4 border-0 shadow-sm">
    <div class="card-body">
      <div class="row g-3 align-items-center">
        <div class="col-md-4">
          <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" class="form-control" id="searchInput" placeholder="Search feedback...">
          </div>
        </div>
        <div class="col-md-3">
          <select class="form-select" id="statusFilter">
            <option value="">All Status</option>
            <option value="pending">🟡 Pending</option>
            <option value="under_review">🔵 Under Review</option>
            <option value="in_progress">🟠 In Progress</option>
            <option value="resolved">🟢 Resolved</option>
            <option value="closed">⚫ Closed</option>
            <option value="rejected">🔴 Rejected</option>
          </select>
        </div>
        <div class="col-md-3">
          <select class="form-select" id="categoryFilter">
            <option value="">All Categories</option>
            <option value="general">💬 General</option>
            <option value="bug">🐛 Bug Report</option>
            <option value="feature">💡 Feature Request</option>
            <option value="complaint">⚠️ Complaint</option>
            <option value="appreciation">❤️ Appreciation</option>
            <option value="suggestion">👆 Suggestion</option>
          </select>
        </div>
        <div class="col-md-2">
          <select class="form-select" id="priorityFilter">
            <option value="">All Priority</option>
            <option value="urgent">🔴 Urgent</option>
            <option value="high">🟠 High</option>
            <option value="medium">🟡 Medium</option>
            <option value="low">🟢 Low</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Feedback List -->
  <div class="feedback-list">
    <% if (feedbacks && feedbacks.length > 0) { %>
      <% feedbacks.forEach(feedback => { %>
        <div class="feedback-item card border-0 shadow-sm mb-4" 
             data-status="<%= feedback.status %>" 
             data-category="<%= feedback.category %>"
             data-priority="<%= feedback.priority %>">
          
          <!-- Feedback Header -->
          <div class="card-header bg-transparent border-0 pb-0">
            <div class="d-flex justify-content-between align-items-start">
              <div class="feedback-main-info">
                <div class="d-flex align-items-center gap-3 mb-2">
                  <span class="category-badge category-<%= feedback.category %>">
                    <!-- Fixed: Direct icon assignment -->
                    <% if (feedback.category === 'general') { %>
                      <i class="fas fa-comment me-1"></i>
                    <% } else if (feedback.category === 'bug') { %>
                      <i class="fas fa-bug me-1"></i>
                    <% } else if (feedback.category === 'feature') { %>
                      <i class="fas fa-lightbulb me-1"></i>
                    <% } else if (feedback.category === 'complaint') { %>
                      <i class="fas fa-exclamation-triangle me-1"></i>
                    <% } else if (feedback.category === 'appreciation') { %>
                      <i class="fas fa-heart me-1"></i>
                    <% } else if (feedback.category === 'suggestion') { %>
                      <i class="fas fa-hand-point-up me-1"></i>
                    <% } else { %>
                      <i class="fas fa-comment me-1"></i>
                    <% } %>
                    <!-- Fixed: Capitalize first letter -->
                    <%= feedback.category.charAt(0).toUpperCase() + feedback.category.slice(1) %>
                  </span>
                  <span class="priority-badge priority-<%= feedback.priority %>">
                    <i class="fas fa-flag me-1"></i>
                    <%= feedback.priority.charAt(0).toUpperCase() + feedback.priority.slice(1) %>
                  </span>
                  <span class="status-badge status-<%= feedback.status %>">
                    <!-- Fixed: Status text directly -->
                    <% if (feedback.status === 'pending') { %>
                      🟡 Pending
                    <% } else if (feedback.status === 'under_review') { %>
                      🔵 Under Review
                    <% } else if (feedback.status === 'in_progress') { %>
                      🟠 In Progress
                    <% } else if (feedback.status === 'resolved') { %>
                      🟢 Resolved
                    <% } else if (feedback.status === 'closed') { %>
                      ⚫ Closed
                    <% } else if (feedback.status === 'rejected') { %>
                      🔴 Rejected
                    <% } else { %>
                      <%= feedback.status %>
                    <% } %>
                  </span>
                </div>
                <h5 class="feedback-title mb-2">
                  <a href="/user/feedback/<%= feedback._id %>" class="text-decoration-none text-dark">
                    <%= feedback.title %>
                  </a>
                </h5>
              </div>
              <div class="feedback-meta text-end">
                <div class="rating-stars-small mb-2">
                  <% if (feedback.rating) { %>
                    <% for(let i = 1; i <= 5; i++) { %>
                      <i class="fas fa-star <%= i <= feedback.rating ? 'text-warning' : 'text-light' %>"></i>
                    <% } %>
                  <% } %>
                </div>
                <div class="text-muted small">
                  <i class="fas fa-clock me-1"></i>
                  <!-- Fixed: Date formatting directly -->
                  <% 
                    const date = new Date(feedback.createdAt);
                    const formattedDate = date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                      hour: '2-digit',
                      minute: '2-digit'
                    });
                  %>
                  <%= formattedDate %>
                </div>
              </div>
            </div>
          </div>

          <!-- Feedback Body -->
          <div class="card-body">
            <p class="feedback-message text-muted mb-3">
              <%= feedback.message.length > 200 ? feedback.message.substring(0, 200) + '...' : feedback.message %>
            </p>

           <!-- Attachments Preview -->
<% if (feedback.attachments && feedback.attachments.length > 0) { %>
  <div class="attachments-preview mb-3">
    <small class="text-muted d-block mb-2">
      <i class="fas fa-paperclip me-1"></i>
      <%= feedback.attachments.length %> attachment(s)
    </small>
    <div class="d-flex gap-2 flex-wrap">
      <% feedback.attachments.slice(0, 3).forEach(attachment => { %>
        <!-- ✅ CHANGE: Make it clickable link -->
        <a href="<%= attachment.url %>" target="_blank" class="attachment-preview text-decoration-none">
          <i class="fas fa-file me-1"></i>
          <small><%= attachment.originalName %></small>
        </a>
      <% }) %>
      <% if (feedback.attachments.length > 3) { %>
        <div class="attachment-preview">
          <small>+<%= feedback.attachments.length - 3 %> more</small>
        </div>
      <% } %>
    </div>
  </div>
<% } %>

            <!-- Admin Response Preview -->
            <% if (feedback.adminResponse && feedback.adminResponse.message) { %>
              <div class="admin-response-preview bg-light rounded p-3 mb-3">
                <div class="d-flex align-items-center mb-2">
                  <div class="admin-avatar me-2">
                    <i class="fas fa-user-shield text-primary"></i>
                  </div>
                  <div>
                    <strong>Admin Response</strong>
                    <small class="text-muted ms-2">
                      <% 
                        const responseDate = new Date(feedback.adminResponse.respondedAt);
                        const formattedResponseDate = responseDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                        });
                      %>
                      <%= formattedResponseDate %>
                    </small>
                  </div>
                </div>
                <p class="mb-0 text-dark">
                  <%= feedback.adminResponse.message.length > 150 ? 
                      feedback.adminResponse.message.substring(0, 150) + '...' : 
                      feedback.adminResponse.message %>
                </p>
              </div>
            <% } %>

            <!-- Follow-ups Count -->
            <% if (feedback.followUps && feedback.followUps.length > 0) { %>
              <div class="follow-ups-indicator">
                <i class="fas fa-comments me-1 text-info"></i>
                <small class="text-muted">
                  <%= feedback.followUps.length %> follow-up<%= feedback.followUps.length > 1 ? 's' : '' %>
                </small>
              </div>
            <% } %>
          </div>

          <!-- Feedback Footer -->
          <div class="card-footer bg-transparent border-0 pt-0">
            <div class="d-flex justify-content-between align-items-center">
              <div class="feedback-actions">
                <a href="/user/feedback/<%= feedback._id %>" class="btn btn-outline-primary btn-sm">
                  <i class="fas fa-eye me-1"></i>View Details
                </a>
                <% if (feedback.status === 'pending' || feedback.status === 'under_review') { %>
                  <button class="btn btn-outline-secondary btn-sm add-followup-btn" 
                          data-feedback-id="<%= feedback._id %>">
                    <i class="fas fa-reply me-1"></i>Add Follow-up
                  </button>
                <% } %>
              </div>
              <div class="feedback-stats">
                <small class="text-muted">
                  <i class="fas fa-calendar me-1"></i>
                  <!-- Calculate days open -->
                  <% 
                    const created = new Date(feedback.createdAt);
                    const now = new Date();
                    const diffTime = Math.abs(now - created);
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                  %>
                  Open for <%= diffDays %> days
                </small>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <!-- Empty State -->
      <div class="empty-state text-center py-5">
        <div class="empty-icon mb-4">
          <i class="fas fa-comment-slash fa-4x text-muted"></i>
        </div>
        <h3 class="text-muted mb-3">No Feedback Yet</h3>
        <p class="text-muted mb-4">You haven't submitted any feedback. Share your thoughts to help us improve!</p>
        <a href="/user/feedback" class="btn btn-primary btn-lg">
          <i class="fas fa-plus me-2"></i>Submit Your First Feedback
        </a>
      </div>
    <% } %>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <nav aria-label="Feedback pagination" class="mt-5">
      <ul class="pagination justify-content-center">
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>">
            <i class="fas fa-chevron-left"></i>
          </a>
        </li>
        
        <% for(let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= i === currentPage ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
          </li>
        <% } %>
        
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>">
            <i class="fas fa-chevron-right"></i>
          </a>
        </li>
      </ul>
    </nav>
  <% } %>
</div>

<!-- Include JavaScript -->
<script src="/users/js/feedback-history.js"></script>

<script>
// Client-side JavaScript for filtering and search
document.addEventListener('DOMContentLoaded', function() {
  const searchInput = document.getElementById('searchInput');
  const statusFilter = document.getElementById('statusFilter');
  const categoryFilter = document.getElementById('categoryFilter');
  const priorityFilter = document.getElementById('priorityFilter');
  const feedbackItems = document.querySelectorAll('.feedback-item');

  function filterFeedbacks() {
    const searchTerm = searchInput.value.toLowerCase();
    const statusValue = statusFilter.value;
    const categoryValue = categoryFilter.value;
    const priorityValue = priorityFilter.value;

    feedbackItems.forEach(item => {
      const title = item.querySelector('.feedback-title').textContent.toLowerCase();
      const message = item.querySelector('.feedback-message').textContent.toLowerCase();
      const status = item.getAttribute('data-status');
      const category = item.getAttribute('data-category');
      const priority = item.getAttribute('data-priority');

      const matchesSearch = title.includes(searchTerm) || message.includes(searchTerm);
      const matchesStatus = !statusValue || status === statusValue;
      const matchesCategory = !categoryValue || category === categoryValue;
      const matchesPriority = !priorityValue || priority === priorityValue;

      if (matchesSearch && matchesStatus && matchesCategory && matchesPriority) {
        item.style.display = 'block';
      } else {
        item.style.display = 'none';
      }
    });
  }

  // Add event listeners
  searchInput.addEventListener('input', filterFeedbacks);
  statusFilter.addEventListener('change', filterFeedbacks);
  categoryFilter.addEventListener('change', filterFeedbacks);
  priorityFilter.addEventListener('change', filterFeedbacks);

  // Add follow-up button functionality
  document.querySelectorAll('.add-followup-btn').forEach(button => {
    button.addEventListener('click', function() {
      const feedbackId = this.getAttribute('data-feedback-id');
      window.location.href = `/user/feedback/${feedbackId}#followup`;
    });
  });
});
</script>

<style>
.history-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20px;
  padding: 3rem 2rem;
  margin-bottom: 3rem;
  color: white;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.header-icon {
  font-size: 4rem;
  opacity: 0.9;
}

.header-text {
  flex: 1;
}

.header-text h1 {
  color: white !important;
  -webkit-text-fill-color: white !important;
}

.header-actions .btn {
  background: rgba(255, 255, 255, 0.2);
  border: 2px solid rgba(255, 255, 255, 0.3);
  color: white;
  backdrop-filter: blur(10px);
}

.header-actions .btn:hover {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(255, 255, 255, 0.5);
}

.stat-card {
  background: white;
  border-radius: 15px;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-5px);
}

.stat-icon {
  width: 60px;
  height: 60px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  color: white;
}

.stat-card.total .stat-icon { background: linear-gradient(135deg, #667eea, #764ba2); }
.stat-card.pending .stat-icon { background: linear-gradient(135deg, #ffd700, #ffb347); }
.stat-card.resolved .stat-icon { background: linear-gradient(135deg, #56ab2f, #a8e6cf); }
.stat-card.in-progress .stat-icon { background: linear-gradient(135deg, #fd746c, #ff9068); }

.stat-number {
  font-size: 2rem;
  font-weight: bold;
  margin: 0;
  line-height: 1;
}

.stat-label {
  color: #6c757d;
  margin: 0;
  font-size: 0.9rem;
}

.search-box {
  position: relative;
}

.search-box i {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: #6c757d;
}

.search-box input {
  padding-left: 45px;
}

.filter-card {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.feedback-item {
  transition: all 0.3s ease;
  border-left: 4px solid #dee2e6;
}

.feedback-item:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
}

.category-badge, .priority-badge, .status-badge {
  padding: 0.25rem 0.75rem;
  border-radius: 20px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: capitalize;
}

.category-general { background: #e3f2fd; color: #1976d2; }
.category-bug { background: #ffebee; color: #d32f2f; }
.category-feature { background: #f3e5f5; color: #7b1fa2; }
.category-complaint { background: #fff3e0; color: #f57c00; }
.category-appreciation { background: #e8f5e8; color: #388e3c; }
.category-suggestion { background: #e0f2f1; color: #00796b; }

.priority-urgent { background: #ffcdd2; color: #c62828; }
.priority-high { background: #ffecb3; color: #ff8f00; }
.priority-medium { background: #fff9c4; color: #f9a825; }
.priority-low { background: #c8e6c9; color: #388e3c; }

.status-pending { background: #fff3cd; color: #856404; }
.status-under_review { background: #cce7ff; color: #004085; }
.status-in_progress { background: #ffe6cc; color: #cc6600; }
.status-resolved { background: #d4edda; color: #155724; }
.status-closed { background: #e2e3e5; color: #383d41; }
.status-rejected { background: #f8d7da; color: #721c24; }

.feedback-title {
  font-weight: 600;
  line-height: 1.4;
}

.rating-stars-small {
  font-size: 0.8rem;
}

.attachment-preview {
  background: #f8f9fa;
  padding: 0.25rem 0.5rem;
  border-radius: 6px;
  font-size: 0.75rem;
  border: 1px solid #e9ecef;
}

.admin-response-preview {
  border-left: 4px solid #007bff;
}

.admin-avatar {
  width: 30px;
  height: 30px;
  background: #007bff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 0.8rem;
}

.empty-state {
  background: white;
  border-radius: 20px;
  padding: 4rem 2rem;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
}

.empty-icon {
  opacity: 0.5;
}

.pagination .page-item.active .page-link {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-color: #667eea;
}

@media (max-width: 768px) {
  .header-content {
    flex-direction: column;
    text-align: center;
  }
  
  .history-header {
    padding: 2rem 1rem;
  }
  
  .stat-card {
    padding: 1rem;
  }
}
</style>
<% layout = 'layouts/user-base' %>

<!-- ✅ ENHANCED SAFE VARIABLES WITH REAL-TIME SUPPORT -->
<%
  // Safe variable assignment with real-time support
  const safeStats = typeof stats !== 'undefined' ? stats : {
    yearlyAttendance: 0,
    yearlyLeaves: 0, 
    yearlyFeedback: 0,
    todayAttendance: 'Not Marked',
    approvedLeaves: 0,
    pendingLeaves: 0,
    pendingFeedback: 0,
    currentYear: new Date().getFullYear(),
    monthlyAttendance: 0,
    currentMonth: new Date().toLocaleString('default', { month: 'long' }),
    attendancePercentage: 0,
    monthlyProgress: 0
  };
  
  const safeUser = typeof user !== 'undefined' ? user : { name: 'User' };
  const safeRecentActivity = typeof recentActivity !== 'undefined' ? recentActivity : {
    attendance: [],
    leaves: [],
    feedback: []
  };
  const safeNotifications = typeof notifications !== 'undefined' ? notifications : {};
  
  // ✅ FIXED: Safe variables for new fields
  const safeLastUpdated = typeof lastUpdated !== 'undefined' ? lastUpdated : new Date();
  const safeDataFreshness = typeof dataFreshness !== 'undefined' ? dataFreshness : 'real-time';
%>

<!-- 🔄 REAL-TIME UPDATE INDICATOR -->
<div class="real-time-indicator" id="realTimeIndicator">
  <div class="indicator-content">
    <i class="fas fa-sync-alt spin"></i>
    <span>Live Data</span>
    <div class="last-updated">
      Updated: <span id="lastUpdatedTime"><%= new Date(safeLastUpdated).toLocaleTimeString() %></span>
    </div>
  </div>
</div>

<div class="container-fluid dashboard-container">
   <button class="sidebar-toggle" onclick="toggleSidebar()">
        <i class="fas fa-bars"></i>
    </button>
  
  <!-- 🎯 ENHANCED HERO WELCOME SECTION -->
  <div class="row mb-5">
    <div class="col-12">
      <div class="hero-welcome">
        <div class="welcome-content">
          <h1 class="welcome-title">
            Welcome back, <span class="gradient-text"><%= safeUser.name %></span>! 👋
          </h1>
          <p class="welcome-subtitle">
            Real-time overview for <strong><%= safeStats.currentMonth %> <%= safeStats.currentYear %></strong>
            <span class="data-freshness <%= safeDataFreshness === 'real-time' ? 'real-time' : 'cached' %>">
              <i class="fas fa-circle"></i>
              <%= safeDataFreshness %>
            </span>
          </p>
          <div class="welcome-stats">
            <div class="stat-badge">
              <i class="fas fa-calendar-check"></i>
              <span><%= safeStats.yearlyAttendance %> Days Present</span>
            </div>
            <div class="stat-badge">
              <i class="fas fa-trophy"></i>
              <span><%= safeStats.attendancePercentage %>% Attendance Rate</span>
            </div>
            <div class="stat-badge pending-badge" id="pendingActionsBadge">
              <i class="fas fa-clock"></i>
              <span><%= safeStats.pendingLeaves + safeStats.pendingFeedback %> Pending</span>
            </div>
          </div>
        </div>
        <div class="welcome-graphic">
          <div class="floating-icons">
            <i class="fas fa-chart-line"></i>
            <i class="fas fa-calendar-alt"></i>
            <i class="fas fa-award"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 📊 ENHANCED MAIN STATS CARDS WITH REAL-TIME UPDATES -->
  <div class="row g-4 mb-5" id="statsCards">
    <!-- Attendance Card -->
    <div class="col-xl-3 col-md-6">
      <div class="stat-card attendance-card">
        <div class="card-icon">
          <i class="fas fa-calendar-check"></i>
        </div>
        <div class="card-content">
          <h3 class="stat-number" id="yearlyAttendance"><%= safeStats.yearlyAttendance %></h3>
          <p class="stat-label">Present Days</p>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= Math.min(safeStats.yearlyAttendance * 2, 100) %>%"></div>
          </div>
          <span class="stat-subtext"><%= safeStats.currentYear %> Performance</span>
        </div>
        <div class="card-wave"></div>
      </div>
    </div>

    <!-- Leaves Card -->
    <div class="col-xl-3 col-md-6">
      <div class="stat-card leaves-card">
        <div class="card-icon">
          <i class="fas fa-plane-departure"></i>
        </div>
        <div class="card-content">
          <h3 class="stat-number" id="yearlyLeaves"><%= safeStats.yearlyLeaves %></h3>
          <p class="stat-label">Leaves Applied</p>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= Math.min(safeStats.yearlyLeaves * 10, 100) %>%"></div>
          </div>
          <span class="stat-subtext">
            <span id="approvedLeaves"><%= safeStats.approvedLeaves %></span> Approved
          </span>
        </div>
        <div class="card-wave"></div>
      </div>
    </div>

    <!-- Feedback Card -->
    <div class="col-xl-3 col-md-6">
      <div class="stat-card feedback-card">
        <div class="card-icon">
          <i class="fas fa-comments"></i>
        </div>
        <div class="card-content">
          <h3 class="stat-number" id="yearlyFeedback"><%= safeStats.yearlyFeedback %></h3>
          <p class="stat-label">Feedback Submitted</p>
          <div class="progress-bar">
            <div class="progress-fill" style="width: <%= Math.min(safeStats.yearlyFeedback * 10, 100) %>%"></div>
          </div>
          <span class="stat-subtext">
            <span id="pendingFeedback"><%= safeStats.pendingFeedback %></span> Pending
          </span>
        </div>
        <div class="card-wave"></div>
      </div>
    </div>

    <!-- Today's Status Card -->
    <div class="col-xl-3 col-md-6">
      <div class="stat-card today-card">
        <div class="card-icon">
          <i class="fas fa-user-check"></i>
        </div>
        <div class="card-content">
          <h3 class="stat-number today-status <%= safeStats.todayAttendance === 'present' ? 'present' : safeStats.todayAttendance === 'Not Marked' ? 'not-marked' : 'other' %>"
              id="todayAttendance">
            <%= safeStats.todayAttendance %>
          </h3>
          <p class="stat-label">Today's Status</p>
          <div class="today-action" id="todayAction">
            <% if (safeStats.todayAttendance === 'Not Marked') { %>
              <a href="/user/attendance" class="action-btn mark-btn">
                <i class="fas fa-plus me-2"></i>Mark Attendance
              </a>
            <% } else { %>
              <span class="status-badge <%= safeStats.todayAttendance === 'present' ? 'present' : 'other' %>">
                <i class="fas fa-check me-2"></i>Completed
              </span>
            <% } %>
          </div>
        </div>
        <div class="card-wave"></div>
      </div>
    </div>
  </div>

  <!-- 🎯 QUICK ACTIONS & RECENT ACTIVITY GRID -->
  <div class="row g-4">
    <!-- Quick Actions -->
    <div class="col-lg-4">
      <div class="feature-card quick-actions-card">
        <div class="card-header">
          <h3><i class="fas fa-bolt me-2"></i>Quick Actions</h3>
          <p>Get things done faster</p>
        </div>
        <div class="card-body">
          <div class="action-grid">
            <a href="/user/attendance" class="action-item primary">
              <div class="action-icon">
                <i class="fas fa-calendar-check"></i>
              </div>
              <div class="action-content">
                <h4>Mark Attendance</h4>
                <p>Record your daily presence</p>
              </div>
              <div class="action-arrow">
                <i class="fas fa-chevron-right"></i>
              </div>
            </a>

            <a href="/user/leaves" class="action-item warning">
              <div class="action-icon">
                <i class="fas fa-plane-departure"></i>
              </div>
              <div class="action-content">
                <h4>Apply Leave</h4>
                <p>Request time off work</p>
              </div>
              <div class="action-arrow">
                <i class="fas fa-chevron-right"></i>
              </div>
            </a>

            <a href="/user/feedback" class="action-item info">
              <div class="action-icon">
                <i class="fas fa-comments"></i>
              </div>
              <div class="action-content">
                <h4>Give Feedback</h4>
                <p>Share your suggestions</p>
              </div>
              <div class="action-arrow">
                <i class="fas fa-chevron-right"></i>
              </div>
            </a>

            <a href="/user/profile" class="action-item success">
              <div class="action-icon">
                <i class="fas fa-user"></i>
              </div>
              <div class="action-content">
                <h4>My Profile</h4>
                <p>Update personal details</p>
              </div>
              <div class="action-arrow">
                <i class="fas fa-chevron-right"></i>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="col-lg-8">
      <div class="feature-card activity-card">
        <div class="card-header">
          <h3><i class="fas fa-history me-2"></i>Recent Activity</h3>
          <p>Your latest actions & updates</p>
        </div>
        <div class="card-body">
          <div class="activity-timeline" id="recentActivity">
            <% if (safeRecentActivity.attendance.length > 0 || safeRecentActivity.leaves.length > 0 || safeRecentActivity.feedback.length > 0) { %>
              <!-- Attendance Activity -->
              <% safeRecentActivity.attendance.slice(0, 3).forEach(attendance => { %>
                <div class="activity-item attendance-activity">
                  <div class="activity-icon">
                    <i class="fas fa-calendar-check"></i>
                  </div>
                  <div class="activity-content">
                    <h5>Attendance Recorded</h5>
                    <p><%= new Date(attendance.date).toLocaleDateString() %> - <%= attendance.status %></p>
                    <small class="text-muted">
                      <% if (attendance.checkIn) { %>
                        Check-in: <%= new Date(attendance.checkIn).toLocaleTimeString() %>
                      <% } %>
                      <% if (attendance.checkOut) { %>
                        • Check-out: <%= new Date(attendance.checkOut).toLocaleTimeString() %>
                      <% } %>
                    </small>
                  </div>
                  <div class="activity-time">
                    <%= new Date(attendance.date).toLocaleDateString() %>
                  </div>
                </div>
              <% }) %>

              <!-- Leaves Activity -->
              <% safeRecentActivity.leaves.slice(0, 3).forEach(leave => { %>
                <div class="activity-item leave-activity">
                  <div class="activity-icon">
                    <i class="fas fa-plane-departure"></i>
                  </div>
                  <div class="activity-content">
                    <h5>Leave <%= leave.status %></h5>
                    <p><%= leave.reason %></p>
                    <small class="text-muted">
                      <%= new Date(leave.startDate).toLocaleDateString() %>
                      <% if (leave.endDate && leave.leaveType === 'full-day') { %>
                        to <%= new Date(leave.endDate).toLocaleDateString() %>
                      <% } %>
                      • <%= leave.days %> day(s)
                    </small>
                  </div>
                  <div class="activity-time">
                    <%= new Date(leave.startDate).toLocaleDateString() %>
                  </div>
                </div>
              <% }) %>

              <!-- Feedback Activity -->
              <% safeRecentActivity.feedback.slice(0, 3).forEach(feedback => { %>
                <div class="activity-item feedback-activity">
                  <div class="activity-icon">
                    <i class="fas fa-comments"></i>
                  </div>
                  <div class="activity-content">
                    <h5>Feedback Submitted</h5>
                    <p><%= feedback.title %></p>
                    <small class="text-muted">
                      Category: <%= feedback.category %> • 
                      Status: <%= feedback.status %>
                      <% if (feedback.rating) { %>
                        • Rating: <%= '★'.repeat(feedback.rating) %>
                      <% } %>
                    </small>
                  </div>
                  <div class="activity-time">
                    <%= new Date(feedback.createdAt).toLocaleDateString() %>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="no-activity">
                <i class="fas fa-inbox fa-3x mb-3 text-muted"></i>
                <h5>No Recent Activity</h5>
                <p class="text-muted">Your recent activities will appear here</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 📈 ENHANCED QUICK STATS SECTION -->
  <div class="row g-4 mt-4">
    <!-- Pending Actions -->
    <div class="col-lg-6">
      <div class="feature-card pending-card">
        <div class="card-header">
          <h3><i class="fas fa-clock me-2"></i>Pending Actions</h3>
          <p>Requires your attention</p>
        </div>
        <div class="card-body">
          <div class="pending-actions-list">
            <% if (safeStats.pendingLeaves > 0) { %>
              <div class="pending-item">
                <div class="pending-icon warning">
                  <i class="fas fa-plane-departure"></i>
                </div>
                <div class="pending-content">
                  <h5><%= safeStats.pendingLeaves %> Pending Leave<%= safeStats.pendingLeaves !== 1 ? 's' : '' %></h5>
                  <p>Awaiting approval from manager</p>
                </div>
                <a href="/user/leaves" class="pending-action-btn">
                  View
                  <i class="fas fa-chevron-right"></i>
                </a>
              </div>
            <% } %>

            <% if (safeStats.pendingFeedback > 0) { %>
              <div class="pending-item">
                <div class="pending-icon info">
                  <i class="fas fa-comments"></i>
                </div>
                <div class="pending-content">
                  <h5><%= safeStats.pendingFeedback %> Pending Feedback<%= safeStats.pendingFeedback !== 1 ? 's' : '' %></h5>
                  <p>Under review by admin team</p>
                </div>
                <a href="/user/feedback" class="pending-action-btn">
                  View
                  <i class="fas fa-chevron-right"></i>
                </a>
              </div>
            <% } %>

            <% if (safeStats.pendingLeaves === 0 && safeStats.pendingFeedback === 0) { %>
              <div class="no-pending">
                <i class="fas fa-check-circle fa-2x text-success mb-3"></i>
                <h5>All Clear!</h5>
                <p class="text-muted">No pending actions at the moment</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="col-lg-6">
      <div class="card stats-card">
        <div class="card-header bg-gradient-primary text-white">
          <h5 class="card-title mb-0">
            <i class="fas fa-chart-pie me-2"></i>Quick Stats
          </h5>
          <small class="opacity-75"><%= safeStats.currentYear %> Overview</small>
        </div>
        <div class="card-body">
          <div class="row g-3">
            <!-- Approved Leaves -->
            <div class="col-6">
              <div class="stat-item text-center p-3 border rounded">
                <div class="stat-icon mb-2">
                  <i class="fas fa-check-circle fa-2x text-success"></i>
                </div>
                <h4 class="stat-value text-success mb-1" id="approvedLeavesStat"><%= safeStats.approvedLeaves %></h4>
                <p class="stat-label text-muted mb-0">Approved Leaves</p>
              </div>
            </div>

            <!-- Pending Leaves -->
            <div class="col-6">
              <div class="stat-item text-center p-3 border rounded">
                <div class="stat-icon mb-2">
                  <i class="fas fa-clock fa-2x text-warning"></i>
                </div>
                <h4 class="stat-value text-warning mb-1" id="pendingLeavesStat"><%= safeStats.pendingLeaves %></h4>
                <p class="stat-label text-muted mb-0">Pending Leaves</p>
              </div>
            </div>

            <!-- Pending Feedback -->
            <div class="col-6">
              <div class="stat-item text-center p-3 border rounded">
                <div class="stat-icon mb-2">
                  <i class="fas fa-hourglass-half fa-2x text-info"></i>
                </div>
                <h4 class="stat-value text-info mb-1" id="pendingFeedbackStat"><%= safeStats.pendingFeedback %></h4>
                <p class="stat-label text-muted mb-0">Pending Feedback</p>
              </div>
            </div>

            <!-- Monthly Attendance -->
            <div class="col-6">
              <div class="stat-item text-center p-3 border rounded">
                <div class="stat-icon mb-2">
                  <i class="fas fa-calendar-alt fa-2x text-primary"></i>
                </div>
                <h4 class="stat-value text-primary mb-1" id="monthlyAttendanceStat"><%= safeStats.monthlyAttendance %></h4>
                <p class="stat-label text-muted mb-0">This Month</p>
              </div>
            </div>
          </div>

          <!-- Progress Section -->
          <div class="mt-4">
            <h6 class="text-muted mb-3">Monthly Progress</h6>
            <div class="progress mb-2" style="height: 10px;">
              <div class="progress-bar bg-success" role="progressbar" 
                   style="width: <%= safeStats.monthlyProgress %>%"
                   id="monthlyProgressBar"
                   aria-valuenow="<%= safeStats.monthlyAttendance || 0 %>" 
                   aria-valuemin="0" aria-valuemax="10">
              </div>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <small class="text-muted" id="monthlyAttendanceText">
                <%= safeStats.monthlyAttendance || 0 %> present days
              </small>
              <small class="text-muted"><%= safeStats.currentMonth %></small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Sidebar Overlay -->
  <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

</div>

<!-- 🎨 ENHANCED CSS WITH REAL-TIME FEATURES -->
<style>
.dashboard-container {
  padding: 20px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  position: relative;
}

/* 🔄 REAL-TIME INDICATOR */
.real-time-indicator {
  position: fixed;
  top: 20px;
  right: 20px;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-radius: 25px;
  padding: 10px 20px;
  box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  z-index: 1000;
  border: 1px solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.real-time-indicator:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0,0,0,0.15);
}

.indicator-content {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.9rem;
  color: #2c3e50;
}

.indicator-content .spin {
  animation: spin 2s linear infinite;
}

.last-updated {
  font-size: 0.8rem;
  color: #6c757d;
}

.data-freshness {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: 600;
  margin-left: 10px;
}

.data-freshness.real-time {
  background: rgba(67, 233, 123, 0.2);
  color: #43e97b;
}

.data-freshness.cached {
  background: rgba(255, 217, 61, 0.2);
  color: #ffd93d;
}

.data-freshness i {
  font-size: 0.6rem;
}

/* 🎯 ENHANCED HERO SECTION */
.hero-welcome {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20px;
  padding: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  position: relative;
  overflow: hidden;
}

.hero-welcome::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 100px;
  height: 100px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  filter: blur(40px);
  opacity: 0.1;
}

.welcome-content {
  flex: 1;
  position: relative;
  z-index: 2;
}

.welcome-title {
  font-size: 2.5rem;
  font-weight: 700;
  margin-bottom: 10px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.welcome-subtitle {
  font-size: 1.1rem;
  color: #6c757d;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
}

.welcome-stats {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.stat-badge {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 8px 16px;
  border-radius: 25px;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.3s ease;
}

.stat-badge:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
}

.pending-badge {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.welcome-graphic {
  position: relative;
}

.floating-icons {
  position: relative;
  width: 120px;
  height: 120px;
}

.floating-icons i {
  position: absolute;
  font-size: 2rem;
  color: #667eea;
  animation: float 3s ease-in-out infinite;
}

.floating-icons i:nth-child(1) { top: 0; left: 0; animation-delay: 0s; }
.floating-icons i:nth-child(2) { top: 40px; right: 0; animation-delay: 1s; }
.floating-icons i:nth-child(3) { bottom: 0; left: 40px; animation-delay: 2s; }

/* 📊 ENHANCED STAT CARDS */
.stat-card {
  background: linear-gradient(135deg, var(--card-color-1) 0%, var(--card-color-2) 100%);
  border-radius: 20px;
  padding: 25px;
  color: white;
  position: relative;
  overflow: hidden;
  min-height: 200px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: all 0.3s ease;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.stat-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.2);
}

.stat-card.attendance-card {
  --card-color-1: #667eea;
  --card-color-2: #764ba2;
}

.stat-card.leaves-card {
  --card-color-1: #f093fb;
  --card-color-2: #f5576c;
}

.stat-card.feedback-card {
  --card-color-1: #4facfe;
  --card-color-2: #00f2fe;
}

.stat-card.today-card {
  --card-color-1: #43e97b;
  --card-color-2: #38f9d7;
}

.card-icon {
  width: 60px;
  height: 60px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  backdrop-filter: blur(10px);
}

.card-icon i {
  font-size: 1.5rem;
  color: white;
}

.stat-number {
  font-size: 2.5rem;
  font-weight: 700;
  color: white;
  margin-bottom: 5px;
  transition: all 0.3s ease;
}

.stat-label {
  font-size: 1rem;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 15px;
}

.progress-bar {
  width: 100%;
  height: 6px;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 10px;
}

.progress-fill {
  height: 100%;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 10px;

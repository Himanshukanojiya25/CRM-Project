<!-- ✨ ENHANCED REAL-TIME JAVASCRIPT -->
<script>
// Real-time dashboard functionality
class RealTimeDashboard {
  constructor() {
    this.updateInterval = 30000; // 30 seconds
    this.isUpdating = false;
    this.lastUpdate = new Date();
    this.init();
  }

  init() {
    console.log('🚀 Initializing Real-time Dashboard...');
    this.startAutoRefresh();
    this.setupEventListeners();
    this.animateProgressBars();
  }

  startAutoRefresh() {
    setInterval(() => {
      this.fetchRealTimeData();
    }, this.updateInterval);

    // Initial fetch after 5 seconds
    setTimeout(() => {
      this.fetchRealTimeData();
    }, 5000);
  }

  async fetchRealTimeData() {
    if (this.isUpdating) return;
    
    this.isUpdating = true;
    this.showUpdatingIndicator();

    try {
      const response = await fetch('/user/dashboard/data');
      const data = await response.json();

      if (data.success) {
        this.updateDashboard(data.data);
        this.updateLastUpdatedTime();
        this.showSuccessIndicator();
      }
    } catch (error) {
      console.error('Failed to fetch real-time data:', error);
      this.showErrorIndicator();
    } finally {
      this.isUpdating = false;
      this.hideUpdatingIndicator();
    }
  }

  updateDashboard(realTimeData) {
    // Update today's attendance
    this.updateElementWithAnimation(
      'todayAttendance',
      realTimeData.todayAttendance,
      true
    );

    // Update pending counts
    this.updateElementWithAnimation(
      'pendingLeavesStat',
      realTimeData.pendingLeaves
    );
    
    this.updateElementWithAnimation(
      'pendingFeedbackStat',
      realTimeData.pendingFeedback
    );

    // Update pending actions badge
    const totalPending = realTimeData.pendingLeaves + realTimeData.pendingFeedback;
    this.updateElementWithAnimation(
      'pendingActionsBadge',
      totalPending + ' Pending'
    );

    // Update today action section if needed
    this.updateTodayAction(realTimeData.todayAttendance);
  }

  updateElementWithAnimation(elementId, newValue, isStatus = false) {
    const element = document.getElementById(elementId);
    if (!element) return;

    const oldValue = element.textContent.trim();
    
    if (oldValue !== newValue.toString()) {
      element.classList.add('value-change');
      
      if (isStatus) {
        this.updateStatusStyles(element, newValue);
      }
      
      element.textContent = newValue;
      
      setTimeout(() => {
        element.classList.remove('value-change');
      }, 1000);
    }
  }

  updateStatusStyles(element, status) {
    // Remove existing status classes
    element.classList.remove('present', 'not-marked', 'other');
    
    // Add new status class
    if (status === 'present') {
      element.classList.add('present');
    } else if (status === 'Not Marked') {
      element.classList.add('not-marked');
    } else {
      element.classList.add('other');
    }
  }

  updateTodayAction(status) {
    const todayAction = document.getElementById('todayAction');
    if (!todayAction) return;

    if (status === 'Not Marked') {
      todayAction.innerHTML = `
        <a href="/user/attendance" class="action-btn mark-btn">
          <i class="fas fa-plus me-2"></i>Mark Attendance
        </a>
      `;
    } else {
      todayAction.innerHTML = `
        <span class="status-badge ${status === 'present' ? 'present' : 'other'}">
          <i class="fas fa-check me-2"></i>Completed
        </span>
      `;
    }
  }

  updateLastUpdatedTime() {
    const lastUpdatedElement = document.getElementById('lastUpdatedTime');
    if (lastUpdatedElement) {
      lastUpdatedElement.textContent = new Date().toLocaleTimeString();
    }
  }

  showUpdatingIndicator() {
    const indicator = document.getElementById('realTimeIndicator');
    if (indicator) {
      indicator.classList.add('updating');
    }
  }

  hideUpdatingIndicator() {
    const indicator = document.getElementById('realTimeIndicator');
    if (indicator) {
      indicator.classList.remove('updating');
    }
  }

  showSuccessIndicator() {
    const indicator = document.getElementById('realTimeIndicator');
    if (indicator) {
      indicator.style.background = 'rgba(67, 233, 123, 0.95)';
      setTimeout(() => {
        indicator.style.background = '';
      }, 2000);
    }
  }

  showErrorIndicator() {
    const indicator = document.getElementById('realTimeIndicator');
    if (indicator) {
      indicator.style.background = 'rgba(245, 87, 108, 0.95)';
      setTimeout(() => {
        indicator.style.background = '';
      }, 2000);
    }
  }

  animateProgressBars() {
    const progressBars = document.querySelectorAll('.progress-fill');
    progressBars.forEach(bar => {
      const width = bar.style.width;
      bar.style.width = '0%';
      setTimeout(() => {
        bar.style.width = width;
      }, 500);
    });
  }

  setupEventListeners() {
    // Add click event to manually refresh
    const indicator = document.getElementById('realTimeIndicator');
    if (indicator) {
      indicator.addEventListener('click', () => {
        this.fetchRealTimeData();
      });
    }

    // Add hover effects to cards
    const cards = document.querySelectorAll('.stat-card, .feature-card');
    cards.forEach(card => {
      card.addEventListener('mouseenter', function() {
        this.style.transform = this.classList.contains('stat-card') ? 
          'translateY(-10px)' : 'translateY(-5px)';
      });
      
      card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
      });
    });
  }
}

// Initialize when DOM is loaded
document.addEventListener('DOMContentLoaded', function() {
  // Initialize real-time dashboard
  new RealTimeDashboard();

  // Real-time clock update
  function updateClock() {
    const now = new Date();
    const timeString = now.toLocaleTimeString('en-US', { 
      hour: '2-digit', 
      minute: '2-digit',
      second: '2-digit',
      hour12: true 
    });
  }
  
  setInterval(updateClock, 1000);
  updateClock();

  // Smooth scrolling for activity timeline
  function smoothScrollTo(element) {
    element.scrollIntoView({ 
      behavior: 'smooth',
      block: 'nearest'
    });
  }

  // Add loading animation to stats
  const stats = document.querySelectorAll('.stat-number');
  stats.forEach(stat => {
    stat.style.opacity = '0';
    setTimeout(() => {
      stat.style.opacity = '1';
      stat.style.transition = 'opacity 0.5s ease';
    }, 300);
  });
});

// Manual refresh function
function refreshDashboard() {
  if (typeof RealTimeDashboard !== 'undefined') {
    const dashboard = new RealTimeDashboard();
    dashboard.fetchRealTimeData();
  }
}

// Export for global access
window.refreshDashboard = refreshDashboard;
</script>


}

.action-btn:hover {
  background: rgba(255, 255, 255, 0.3);
  color: white;
  transform: translateY(-2px);
}

.status-badge {
  padding: 6px 12px;
  border-radius: 15px;
  font-size: 0.8rem;
  font-weight: 600;
}

.status-badge.present {
  background: rgba(67, 233, 123, 0.2);
  color: #43e97b;
}

.status-badge.other {
  background: rgba(255, 217, 61, 0.2);
  color: #ffd93d;
}

.card-wave {
  position: absolute;
  bottom: -10px;
  left: 0;
  width: 100%;
  height: 20px;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="rgba(255,255,255,0.1)"></path></svg>');
  background-size: cover;
}

/* 🎯 FEATURE CARDS */
.feature-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 15px 35px rgba(0,0,0,0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.feature-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

.card-header {
  padding: 25px 25px 0;
  border-bottom: 1px solid rgba(0,0,0,0.1);
  margin-bottom: 0;
}

.card-header h3 {
  font-size: 1.3rem;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 5px;
}

.card-header p {
  color: #6c757d;
  margin-bottom: 20px;
}

.card-body {
  padding: 25px;
}

/* 🚀 QUICK ACTIONS */
.action-grid {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.action-item {
  display: flex;
  align-items: center;
  padding: 20px;
  border-radius: 15px;
  text-decoration: none;
  transition: all 0.3s ease;
  border: 1px solid transparent;
}

.action-item:hover {
  transform: translateX(10px);
  text-decoration: none;
}

.action-item.primary {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-color: rgba(102, 126, 234, 0.2);
}

.action-item.warning {
  background: linear-gradient(135deg, rgba(240, 147, 251, 0.1) 0%, rgba(245, 87, 108, 0.1) 100%);
  border-color: rgba(245, 87, 108, 0.2);
}

.action-item.info {
  background: linear-gradient(135deg, rgba(79, 172, 254, 0.1) 0%, rgba(0, 242, 254, 0.1) 100%);
  border-color: rgba(79, 172, 254, 0.2);
}

.action-item.success {
  background: linear-gradient(135deg, rgba(67, 233, 123, 0.1) 0%, rgba(56, 249, 215, 0.1) 100%);
  border-color: rgba(67, 233, 123, 0.2);
}

.action-item:hover.primary { background: rgba(102, 126, 234, 0.15); }
.action-item:hover.warning { background: rgba(245, 87, 108, 0.15); }
.action-item:hover.info { background: rgba(79, 172, 254, 0.15); }
.action-item:hover.success { background: rgba(67, 233, 123, 0.15); }

.action-icon {
  width: 50px;
  height: 50px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 15px;
  font-size: 1.2rem;
}

.action-item.primary .action-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.action-item.warning .action-icon {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.action-item.info .action-icon {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
}

.action-item.success .action-icon {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: white;
}

.action-content {
  flex: 1;
}

.action-content h4 {
  font-size: 1.1rem;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 5px;
}

.action-content p {
  font-size: 0.9rem;
  color: #6c757d;
  margin: 0;
}

.action-arrow {
  color: #6c757d;
  transition: all 0.3s ease;
}

.action-item:hover .action-arrow {
  color: #667eea;
  transform: translateX(5px);
}

/* ✨ ANIMATIONS */
@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes gradient {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.gradient-text {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradient 3s ease infinite;
}

/* 📱 RESPONSIVE DESIGN */
@media (max-width: 768px) {
  .hero-welcome {
    flex-direction: column;
    text-align: center;
    padding: 30px 20px;
  }
  
  .welcome-title {
    font-size: 2rem;
  }
  
  .welcome-stats {
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .stat-card {
    padding: 20px;
  }
  
  .stat-number {

  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.7);
}

.today-status.present { color: #43e97b; }
.today-status.not-marked { color: #ff6b6b; }
.today-status.other { color: #ffd93d; }

.today-action {
  margin-top: 15px;
}

.action-btn {
